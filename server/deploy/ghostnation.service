[Unit]
Description=GhostNation World API
After=network.target

[Service]
WorkingDirectory=/opt/ghostnation
# GC_JWT_SECRET ДОЛЖЕН совпадать с ghostchat (верификация токенов GhostEcos). Ставится на сервере, НЕ в git.
Environment=GC_JWT_SECRET=<set-on-server-MUST-match-ghostchat>
# Опционально: NATION_DB=/opt/ghostnation/nation.db (по умолчанию рядом со server.py)
ExecStart=/opt/ghostnation/venv/bin/uvicorn server:app --host 127.0.0.1 --port 8010
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

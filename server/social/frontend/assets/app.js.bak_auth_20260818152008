// 1500 → 1.5K, 1_200_000 → 1.2M (компактно для UI-счётчиков)
function formatCount(n) {
  n = +n || 0;
  if (n < 1000) return String(n);
  if (n < 1000000) return (n / 1000).toFixed(n < 10000 ? 1 : 0).replace(/\.0$/, '') + 'K';
  return (n / 1000000).toFixed(1).replace(/\.0$/, '') + 'M';
}


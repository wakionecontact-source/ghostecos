/* реакция на коммент */
async function _comReact(cid, emoji){
  if (typeof isGuest === 'function' && isGuest()){ if (typeof guestBlock === 'function') guestBlock(); return; }
  try{
    var r = await api('/com/' + cid + '/react', 'POST', { emoji: emoji });
    _comUpdateReact(cid, r.your_emoji, r.counts || {});
  }catch(e){ if (typeof showToast === 'function') showToast('Ошибка'); }
}
function _comUpdateReact(cid, your, counts){
  var btn = document.querySelector('.com-react[data-cid="' + cid + '"]'); if (!btn) return;
  var total = 0; for (var k2 in counts) total += counts[k2];
  var distinct = Object.keys(counts).length;
  btn.classList.toggle('on', !!your);
  btn.dataset.your = your || '';
  btn.innerHTML = (your ? emojiSvg(your) : '<i class="fa-regular fa-heart"></i>') + ((total && distinct <= 1) ? '<span class="cc">' + total + '</span>' : '');
  var item = document.querySelector('.comment-item[data-cid="' + cid + '"]'); if (!item) return;
  var body = item.querySelector('.comment-item-body');
  var pills = (typeof EMOJI_ORDER !== 'undefined' ? EMOJI_ORDER : ['heart','fire','laugh','sad','clap','eyes']).filter(function(k){ return counts[k]; }).map(function(k){
    var cls = k === your ? ' mine' : '';
    return '<span class="react-pill com-react-pill' + cls + '" data-action="com-react-pill" data-cid="' + cid + '" data-emoji="' + k + '">' + emojiSvg(k) + counts[k] + '</span>';
  }).join('');
  var row = body.querySelector('.com-reactions');
  if (distinct > 1) {
    if (!row) { row = document.createElement('div'); row.className = 'com-reactions'; btn.insertAdjacentElement('afterend', row); }
    row.innerHTML = pills;
  } else if (row) { row.remove(); }
}
/* бар эмодзи для комментов (свои переменные, те же CSS-классы) */
var _comBarEl = null, _comBarBd = null, _comBarTO = null;
function _comCloseBar(){

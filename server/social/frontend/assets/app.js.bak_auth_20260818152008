  function bindBurgerDrag(){
    var b = el('mskcBurger'); var startX=0, dragging=false;
    function down(e){if(media.length<2)return;e.preventDefault();dragging=true;startX=e.clientX;b.classList.add('drag');try{b.setPointerCapture(e.pointerId);}catch(_){} }
    function move(e){
      if(!dragging)return;
      e.preventDefault();var dx=e.clientX-startX,step=56;
      if (dx > step && idx < media.length-1){swap(idx,idx+1);idx++;startX=e.clientX;renderCarousel();}
      else if (dx < -step && idx > 0){swap(idx,idx-1);idx--;startX=e.clientX;renderCarousel();}
    }
    function up(){ dragging=false; b.classList.remove('drag'); }
    b.addEventListener('pointerdown',down);b.addEventListener('pointermove',move);b.addEventListener('pointerup',up);b.addEventListener('pointercancel',up);
  }
  function bindCarouselReorder(){
    var c=el('mskcCarousel'), startX=0, startY=0, dragging=false;
    if(!c)return;
    c.addEventListener('pointerdown', function(e){
      if(e.pointerType==='mouse' || !media.length || (e.target.closest && (e.target.closest('.mskc-video-ui') || e.target.closest('video'))))return;
      var slide=e.target.closest && e.target.closest('.mskc-slide.active');
      if(!slide)return;
      e.preventDefault();
      dragging=true; c._mskcReordered=false; startX=e.clientX; startY=e.clientY;
      try{c.setPointerCapture(e.pointerId);}catch(_){ }
    }, {passive:false});
    c.addEventListener('pointermove', function(e){
      if(!dragging)return;
      var dx=e.clientX-startX, dy=e.clientY-startY;
      if(Math.abs(dx)<42 || Math.abs(dx)<=Math.abs(dy))return;
      e.preventDefault();
      var dir=dx>0?1:-1, next=idx+dir;
      if(next>=0 && next<media.length){
        swap(idx,next); idx=next; c._mskcReordered=true; renderCarousel();
      }
      startX=e.clientX; startY=e.clientY;
    }, {passive:false});
    function stop(){dragging=false;}
    c.addEventListener('pointerup',stop); c.addEventListener('pointercancel',stop);
  }
  function swap(a,b2){ var t=media[a]; media[a]=media[b2]; media[b2]=t; }


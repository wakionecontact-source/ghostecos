    +     quote
    +     '<div class="comment-text">' + linkifyContent(c.text) + '</div>'
    +     '<div class="comment-footer">'
    +       '<button class="com-react' + (your ? ' on' : '') + '" data-cid="' + c.id + '" data-your="' + (your || '') + '">' + (your ? emojiSvg(your) : '<i class="fa-regular fa-heart"></i>') + ((_total && _distinct <= 1) ? '<span class="cc">' + _total + '</span>' : '') + '</button>'
    +       reactionsRow
    +       '<button class="com-reply" data-cid="' + c.id + '" data-un="' + esc(c.username) + '">Ответить</button>'

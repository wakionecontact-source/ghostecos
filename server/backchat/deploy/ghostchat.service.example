[Unit]
Description=GhostChat relay (uvicorn)
After=network.target

[Service]
Type=simple
# Пользователь без root; каталог с кодом должен быть ему доступен на чтение/запись (uploads, БД).
User=www-data
Group=www-data
WorkingDirectory=/opt/ghostchat/server
Environment=GHOSTCHAT_DISABLE_DOCS=1
# Создай /etc/ghostchat.env: GHOSTCHAT_ADMIN_KEY=… GHOSTCHAT_SUPPORT_PASSWORD=…
EnvironmentFile=-/etc/ghostchat.env
# Прод: main_remote.py; локально иногда main.py — поменяй модуль при необходимости.
ExecStart=/opt/ghostchat/server/.venv/bin/uvicorn main_remote:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

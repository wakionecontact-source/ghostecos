  let W = 0, sx = 0, sy = 0, dragging = false, axis = null, mode = null, committing = false;
  const EASE = 'transform .25s cubic-bezier(.32,.72,0,1)';
  const setT = (el, x) => { if (el) el.style.transform = 'translateX(' + x + 'px)'; };

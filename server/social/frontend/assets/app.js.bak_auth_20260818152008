  // ── хэштеги ──
  var MSK_TAG_MIN_C = 3, MSK_TAG_MAX_C = 10;
  function sanitizeTag(s){ return (s||'').replace(/^#+/,'').replace(/[^0-9A-Za-zА-Яа-яЁё_]/g,'').toLowerCase().slice(0,30); }
  function collectTags(){ // непустые валидные (>=2) теги
    return tagFields.map(sanitizeTag).filter(function(t){ return t.length>=2; });
  }
  function addTagField(){
    if (tagFields.length>=MSK_TAG_MAX_C) return;
    tagFields.push(''); renderTagFields();
  }
  function removeTagField(i){
    if (tagFields.length<=MSK_TAG_MIN_C) return;
    tagFields.splice(i,1); renderTagFields();
  }
  function renderTagFields(){
    var box=el('mskcTagFields'); if(!box)return;
    box.innerHTML='';
    tagFields.forEach(function(v,i){
      var removable = i>=MSK_TAG_MIN_C;
      var wrap=document.createElement('div'); wrap.className='mskc-tagf'+(removable?' rem':'');
      wrap.innerHTML='<div class="mskc-tagf-inputwrap'+(v?' hide-hash':'')+'"><span class="mskc-tagf-hash">#</span>'+
        '<input class="mskc-tagf-input" maxlength="30" placeholder="тег'+(i+1)+'" value="'+esc(v)+'"></div>'+
        (removable?'<button class="mskc-tagf-x" title="Убрать"><i class="fa-solid fa-xmark"></i></button>':'');
      var inpwrap=wrap.querySelector('.mskc-tagf-inputwrap');
      var inp=wrap.querySelector('input');
      inp.addEventListener('input', function(){
        inp.value = inp.value.replace(/^#+/,'').replace(/[^0-9A-Za-zА-Яа-яЁё_]/g,'');
        tagFields[i]=inp.value; updateTagCount();
      });
      inp.addEventListener('focus', function(){ inpwrap.classList.add('hide-hash'); });
      inp.addEventListener('blur', function(){ if(!inp.value) inpwrap.classList.remove('hide-hash'); });
      var xb=wrap.querySelector('.mskc-tagf-x');
      if (xb) xb.addEventListener('click', function(){ removeTagField(i); });
      box.appendChild(wrap);
    });
    var addBtn=el('mskcTagAddField');
    if (addBtn) addBtn.style.display = tagFields.length>=MSK_TAG_MAX_C ? 'none' : '';
    updateTagCount();
  }
  function updateTagCount(){
    var c=collectTags().length, el2=el('mskcTagsCount');

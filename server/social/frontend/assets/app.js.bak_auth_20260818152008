  // общий путь обработки выбранного файла — из <input type=file> ИЛИ из drag&drop (десктоп)
  function handlePickedFile(file, stayInCamera){
    if (!file) return;
    if (media.length >= 5){ showToast('Максимум 5 вложений'); return; }
    var isVideo = /^video\//.test(file.type) || /\.(mp4|webm|mov)$/i.test(file.name);
    if (isVideo && media.some(function(m){ return m.type==='video'; })){
      showToast('Уже максимальное количество видео'); return;
    }
    var maxV = (typeof MAX_SIZE!=='undefined' && MAX_SIZE.video) ? MAX_SIZE.video : 150*1024*1024;
    var maxI = (typeof MAX_SIZE!=='undefined' && MAX_SIZE.image) ? MAX_SIZE.image : 30*1024*1024;
    if (isVideo && file.size > maxV){ showToast('Видео слишком большое'); return; }
    if (!isVideo && file.size > maxI){ showToast('Фото слишком большое'); return; }
    // ЛОКАЛЬНЫЙ просмотр + копируем данные файла в память (Blob), чтобы он
    // не "протух" к моменту публикации (Android/iOS инвалидируют File из галереи)
    var localUrl = URL.createObjectURL(file);
    var item = { file:file, blob:null, localUrl:localUrl, type: isVideo?'video':'image', name:file.name, mime:file.type||'' };
    media.push(item);
    idx = media.length - 1;
    addingMore = false;
    if(!isVideo)updateGalleryThumb(localUrl);
    if(!stayInCamera)showStage('assembly');
    // читаем в Blob в фоне (data выживает независимо от input)
    try{
      file.arrayBuffer().then(function(buf){
        item.blob = new Blob([buf], { type: item.mime || (isVideo?'video/mp4':'image/jpeg') });
      }).catch(function(){ /* оставим item.file как запасной */ });
    }catch(e){}
  }

  // десктоп: drag-and-drop файла прямо в pick-экран (безопасно навешивать всегда —
  // drag-события не стреляют на тач-устройствах без мыши/DnD)
  function bindPickDrop(){
    var zone = document.querySelector('#mskCompose .mskc-pick-inner');
    if (!zone) return;
    zone.addEventListener('dragover', function(e){
      e.preventDefault();
      zone.classList.add('dragover');
    });
    zone.addEventListener('dragleave', function(){
      zone.classList.remove('dragover');
    });
    zone.addEventListener('drop', function(e){
      e.preventDefault();
      zone.classList.remove('dragover');
      var file = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
      if (file) handlePickedFile(file);
    });
  }

  function renderCarousel(){
    var c = el('mskcCarousel'); if (!c) return;
    if (idx >= media.length) idx = media.length - 1;
    if (idx < 0) idx = 0;
    var previousIdx = typeof c._mskcRenderIdx === 'number' ? c._mskcRenderIdx : idx;
    c.innerHTML = '<div class="mskc-carousel-track"></div>';
    var track = c.querySelector('.mskc-carousel-track');
    // ф4: крупная перестройка .innerHTML каждый раз не даёт держать персистентные узлы для
    // честного transform-slide — поэтому делаем лёгкий opacity-кроссфейд: все слайды рендерим
    // БЕЗ .active (opacity:0 по CSS), а класс .active на нужном слайде вешаем через rAF на
    // следующий кадр — тогда CSS-transition реально анимирует переход, а не просто "щёлкает".
    media.forEach(function(m, i){
      var slide = document.createElement('div');
      slide.className = 'mskc-slide';
      var src = m.localUrl || m.url;
      slide.innerHTML = (m.type==='video')
        ? '<video src="'+src+'" playsinline preload="metadata"></video><div class="mskc-video-ui"><button type="button" class="mskc-video-play" aria-label="Воспроизвести"><i class="fa-solid fa-play"></i></button><span class="mskc-video-time">0:00</span><input class="mskc-video-seek" type="range" min="0" max="1000" value="0" aria-label="Позиция видео"><button type="button" class="mskc-video-sound" aria-label="Выключить звук"><i class="fa-solid fa-volume-high"></i></button></div>'
        : '<img src="'+src+'">';
      track.appendChild(slide);
    });
    // точки
    var d = el('mskcDots'); d.innerHTML='';
    if (media.length > 1){
      media.forEach(function(m,i){
        var dot=document.createElement('span'); dot.className='mskc-dot'+(i===idx?' on':'');
        d.appendChild(dot);
      });
    }
    // бургер только если >1
    el('mskcBurger').style.display = media.length>1 ? 'flex' : 'none';
    // плюс тускнеет на лимите
    el('mskcAddMore').classList.toggle('disabled', media.length>=5);
    // десктоп-стрелки навигации: видны только если есть что листать
    var navPrev = el('mskcNavPrev'), navNext = el('mskcNavNext');
    if (navPrev && navNext){
      var canNav = media.length > 1;
      navPrev.classList.toggle('show', canNav);
      navNext.classList.toggle('show', canNav);
      navPrev.disabled = !canNav;
      navNext.disabled = !canNav;
    }
    // Кастомный player для assembly: play/pause, таймлайн, время и звук.
    var slides = track.querySelectorAll('.mskc-slide');
    slides.forEach(function(s, i){
      var v = s.querySelector('video'); if(!v) return;
      var play=s.querySelector('.mskc-video-play'),seek=s.querySelector('.mskc-video-seek'),sound=s.querySelector('.mskc-video-sound'),time=s.querySelector('.mskc-video-time');
      v.muted=false;v.playsInline=true;v.loop=false;
      function fmt(sec){sec=Math.max(0,Math.floor(sec||0));return Math.floor(sec/60)+':'+String(sec%60).padStart(2,'0');}
      function sync(){
        var duration=isFinite(v.duration)?v.duration:0;
        if(seek&&!seek.matches(':active'))seek.value=duration?Math.round(v.currentTime/duration*1000):0;
        if(time)time.textContent=fmt(v.currentTime)+' / '+fmt(duration);
        if(play)play.innerHTML='<i class="fa-solid fa-'+(v.paused?'play':'pause')+'"></i>';
      }
      play.addEventListener('click',function(e){e.stopPropagation();if(v.paused)v.play().catch(function(){});else v.pause();});
      seek.addEventListener('input',function(e){e.stopPropagation();if(v.duration)v.currentTime=(+seek.value/1000)*v.duration;});
      sound.addEventListener('click',function(e){e.stopPropagation();v.muted=!v.muted;sound.innerHTML='<i class="fa-solid fa-volume-'+(v.muted?'xmark':'high')+'"></i>';});
      ['loadedmetadata','timeupdate','play','pause','ended'].forEach(function(ev){v.addEventListener(ev,sync);});
      v.addEventListener('click',function(){if(v.paused)v.play().catch(function(){});else v.pause();});
      sync();
      if(i!==idx){try{v.pause();v.currentTime=0;}catch(e){}}
    });
    // активируем нужный слайд на следующем кадре, чтобы сработал CSS-переход opacity
    track.style.transition = 'none';
    track.style.transform = 'translate3d('+(-previousIdx*100)+'%,0,0)';
    requestAnimationFrame(function(){
      var s2 = track.querySelectorAll('.mskc-slide');
      s2.forEach(function(s, i){ s.classList.toggle('active', i===idx); });
      track.style.transition = 'transform .32s cubic-bezier(.22,.61,.36,1)';
      track.style.transform = 'translate3d('+(-idx*100)+'%,0,0)';
      c._mskcRenderIdx = idx;
    });
  }

  function go(delta){
    if (media.length<2) return;
    idx = (idx + delta + media.length) % media.length;
    renderCarousel();

   async function openCamera(){
     showStage('camera');
     if(cameraOpening || cameraStream || document.hidden)return;
     cameraOpening=true; cameraSuspended=false;
     var session=++cameraSession;
     var status=el('mskcCameraStatus'); if(status)status.textContent='Запуск камеры...';
     if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){ cameraOpening=false; if(status)status.textContent='Камера недоступна. Откройте галерею.'; return; }
     try {
       // Ограничение 720p/30 fps заметно снижает нагрузку MediaRecorder на телефонах.
       var videoConstraints={ facingMode:{ ideal:facingMode }, width:{ ideal:1280 }, height:{ ideal:720 }, frameRate:{ ideal:30, max:30 } };
       var stream;
       try {
         stream = await navigator.mediaDevices.getUserMedia({ video:videoConstraints, audio:{ echoCancellation:true, noiseSuppression:true } });
       } catch(firstError) {
         stream = await navigator.mediaDevices.getUserMedia({ video:videoConstraints, audio:false });
       }
       if(session!==cameraSession || !cameraStageActive() || document.hidden){stream.getTracks().forEach(function(t){t.stop();});return;}
       cameraStream=stream;
       var preview = el('mskcCameraVideo');
       preview.style.display = 'block';
       preview.style.visibility = 'visible';
       preview.srcObject = cameraStream;
       preview.onloadedmetadata = function(){ preview.play().catch(function(){}); };
       preview.onplaying = hideCameraLastFrame;
       await preview.play().catch(function(){});
       setTimeout(hideCameraLastFrame,120);
       if(status)status.textContent='Нажмите для фото, удерживайте для видео';
     } catch(e){
       if(status)status.textContent='Камера недоступна. Откройте галерею.';
       showToast('Не удалось открыть камеру: '+((e&&e.name)||'ошибка'));
     } finally {
       cameraOpening=false;
     }
   }
   function stopCamera(discard, preserveLastFrame){
     cameraSession++; cameraOpening=false;
     cameraDiscard=discard!==false;
     if(preserveLastFrame)captureCameraLastFrame();
     if (cameraPressTimer){ clearTimeout(cameraPressTimer); cameraPressTimer=null; }
     if (cameraStopTimer){ clearTimeout(cameraStopTimer); cameraStopTimer=null; }
     if (cameraRecorder && cameraRecorder.state !== 'inactive'){ try{ cameraRecorder.stop(); }catch(_){} }
     cameraRecorder=null; cameraChunks=[]; cameraRecording=false; cameraLocked=false;
     if (cameraStream){ cameraStream.getTracks().forEach(function(t){ t.stop(); }); cameraStream=null; }
     var v=el('mskcCameraVideo'); if(v) v.srcObject=null;
     if(!preserveLastFrame)clearCameraLastFrame();
     resetCameraUi();
   }
   async function switchCamera(){
     if (!cameraStageActive()) return;
     facingMode = facingMode === 'environment' ? 'user' : 'environment';
     stopCamera(undefined,true); await openCamera();
   }
   function cameraFile(blob, type, stayInCamera){
     var ext=type==='video'?'webm':'jpg';
     var file=new File([blob], 'camera_'+Date.now()+'.'+ext, {type:blob.type || (type==='video'?'video/webm':'image/jpeg')});
     return handlePickedFile(file, !!stayInCamera);
   }
   function capturePhoto(stayInCamera){
     var video=el('mskcCameraVideo'), canvas=el('mskcCameraCanvas');
     if(stayInCamera && media.length>=4){showToast('Оставлено место для записываемого видео');return;}
     if (!video.videoWidth) return;
     canvas.width=video.videoWidth; canvas.height=video.videoHeight;
     canvas.getContext('2d').drawImage(video,0,0,canvas.width,canvas.height);
     canvas.toBlob(function(blob){
       if(!blob)return;
       cameraFile(blob,'image',stayInCamera);
       if(stayInCamera)showToast('Фото добавлено в карусель');
     }, 'image/jpeg', .9);
   }
   function setRecordingLocked(locked){
     cameraLocked=!!locked;
     var shutter=el('mskcShutter'); if(shutter)shutter.classList.toggle('locked',cameraLocked);
     var lock=el('mskcCameraLock'); if(lock)lock.style.display=cameraLocked?'flex':'none';
     var guide=el('mskcCameraLockGuide');
     if(guide){
       guide.classList.toggle('locked',cameraLocked);guide.style.setProperty('--lock-progress',cameraLocked?'1':'0');
       if(cameraLocked){guide.classList.add('docking');setTimeout(function(){guide.classList.remove('show','docking');},420);}
     }
     var status=el('mskcCameraStatus');
     if(status)status.textContent=cameraLocked?'Запись закреплена. Нажмите кнопку съёмки для остановки':'Запись... Проведите вверх для блокировки';
   }
   function startVideo(locked){
     if (!cameraStream || cameraRecording) return;
     if(media.some(function(m){return m.type==='video';})){showToast('В карусели уже есть видео');return;}
     if(media.length>=5){showToast('Максимум 5 вложений');return;}
     if (typeof MediaRecorder === 'undefined'){ showToast('Запись видео недоступна'); return; }
     // VP8 обычно аппаратно ускоряется лучше VP9 на мобильных браузерах.
     var mime=['video/webm;codecs=vp8,opus','video/webm;codecs=vp9,opus','video/webm'].find(function(x){ return MediaRecorder.isTypeSupported(x); }) || '';
     var options={videoBitsPerSecond:2500000,audioBitsPerSecond:96000}; if(mime)options.mimeType=mime;
     try{ cameraRecorder=new MediaRecorder(cameraStream,options); }catch(_){ showToast('Видео не поддерживается'); return; }
     cameraChunks=[]; cameraRecording=true; cameraLocked=false; cameraDiscard=false;
     cameraRecorder.ondataavailable=function(e){ if(e.data.size) cameraChunks.push(e.data); };
     cameraRecorder.onstop=function(){
       var blob=new Blob(cameraChunks,{type:(cameraRecorder && cameraRecorder.mimeType)||'video/webm'}); cameraRecording=false; cameraChunks=[];
       if(!cameraDiscard && blob.size){ cameraFile(blob,'video'); showStage('assembly'); }
       var st=el('mskcCameraStatus'); if(st) st.textContent='Нажмите для фото, удерживайте для видео';
       resetCameraUi();
     };
     cameraRecorder.start(1000);
     var shutter=el('mskcShutter'); if(shutter)shutter.classList.add('recording');
     setRecordingLocked(locked);
     cameraStopTimer=setTimeout(function(){ if(cameraRecording)stopVideo(); },60000);
   }
   function stopVideo(){ if(cameraStopTimer){clearTimeout(cameraStopTimer);cameraStopTimer=null;} if(cameraRecorder && cameraRecorder.state==='recording') cameraRecorder.stop(); }
   function bindCameraControls(){
     var b=el('mskcShutter'),lock=el('mskcCameraLock'); if(!b)return;
     var pointerDown=false,longPress=false,moved=false,swipeLockRequested=false,doubleTapActive=false,pendingTap=null,lastTap=0,unlockWindow=null,unlockPending=false,unlockAttempt=false,suppressUnlockRelease=false;
     function clearPress(){if(cameraPressTimer){clearTimeout(cameraPressTimer);cameraPressTimer=null;}}
     function down(e){
       if(e.pointerType==='mouse')return; e.preventDefault(); pointerDown=true;longPress=false;moved=false;swipeLockRequested=false;doubleTapActive=false;cameraPressStartY=e.clientY;
       try{b.setPointerCapture(e.pointerId);}catch(_){}
       if(unlockPending){
         unlockAttempt=true;
         cameraPressTimer=setTimeout(function(){
           cameraPressTimer=null;unlockAttempt=false;unlockPending=false;suppressUnlockRelease=true;
           if(unlockWindow){clearTimeout(unlockWindow);unlockWindow=null;}
           lock.classList.remove('unlocking');setRecordingLocked(false);showToast('Запись разблокирована');
         },220);
         return;
       }
       var now=Date.now();
       if(now-lastTap<340){
         lastTap=0;doubleTapActive=true;
         if(pendingTap){clearTimeout(pendingTap);pendingTap=null;}
         if(cameraRecording&&cameraLocked)capturePhoto(true);
         else if(!cameraRecording)startVideo(true);
         return;
       }
       if(cameraRecording && cameraLocked)return;
       cameraPressTimer=setTimeout(function(){cameraPressTimer=null;longPress=true;startVideo(false);},220);
     }
     function move(e){
       if(!pointerDown)return;
       var dy=Math.max(0,cameraPressStartY-e.clientY),progress=Math.min(1,dy/120),guide=el('mskcCameraLockGuide');
       if(dy>8)moved=true;
       if(progress>=.88)swipeLockRequested=true;
       if(guide && dy>8 && ((!cameraRecording) || (cameraRecording&&!cameraLocked))){
         guide.classList.add('show'); guide.style.setProperty('--lock-progress',String(progress));
       } else if(guide && dy<=8 && !cameraLocked){
         guide.classList.remove('show'); guide.style.setProperty('--lock-progress','0');
       }
     }
     function up(e){
       if(e.pointerType==='mouse')return; e.preventDefault(); pointerDown=false;clearPress();
       if(doubleTapActive){doubleTapActive=false;return;}
       if(unlockAttempt){unlockAttempt=false;return;}
       if(suppressUnlockRelease){suppressUnlockRelease=false;return;}
       if(cameraRecording){
          if(swipeLockRequested&&!cameraLocked){setRecordingLocked(true);return;}
         if(cameraLocked){
           lastTap=Date.now();
           pendingTap=setTimeout(function(){pendingTap=null;lastTap=0;if(cameraRecording&&cameraLocked)stopVideo();},340);
         }else if(longPress||moved)stopVideo();
         return;
       }
       if(swipeLockRequested){startVideo(true);return;}
       lastTap=Date.now();
       pendingTap=setTimeout(function(){pendingTap=null;lastTap=0;if(!cameraRecording)capturePhoto(false);},340);
     }
     b.addEventListener('pointerdown',down);b.addEventListener('pointermove',move);b.addEventListener('pointerup',up);
     b.addEventListener('pointercancel',function(){pointerDown=false;clearPress();if(cameraRecording&&!cameraLocked)stopVideo();});
     lock.addEventListener('click',function(){
       if(!cameraRecording||!cameraLocked)return;
       unlockPending=true;
       lock.classList.add('unlocking');
       var status=el('mskcCameraStatus');if(status)status.textContent='Зажмите кнопку съёмки в течение 1,5 секунды';
       if(unlockWindow)clearTimeout(unlockWindow);
       unlockWindow=setTimeout(function(){unlockWindow=null;unlockPending=false;lock.classList.remove('unlocking');if(cameraRecording)stopVideo();},1500);
     });
   }


# GhostEcos Shop — пример переменных окружения
# Скопируй в .env и заполни своими значениями. .env в git НЕ попадает.

# ── Telegram bot ──
# Получи токен у @BotFather
BOT_TOKEN=PUT_YOUR_TOKEN_HERE

# Твой Telegram user_id (числовой, узнать у @userinfobot)
OWNER_TG_ID=0

# GhostChat username владельца (для cross-app логики)
OWNER_GC_USERNAME=

# ── Безопасность ──
# JWT_SECRET — для подписи токенов веб-админки. Сгенерируй случайные 32+ байта.
# Пример: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev_insecure_secret_change_me

# OWNER_PASSWORD — пароль для входа в shop-веб (если auth включён)
OWNER_PASSWORD=

# ── Цены Premium (можно менять) ──
PRICE_FULL_RUB=490
PRICE_DISC_RUB=245
PRICE_FULL_USDT=5.50
PRICE_DISC_USDT=2.75
DISCOUNT_HOURS=72
PREMIUM_MONTHS=12

# ── Платёжные ссылки (опционально) ──
SEND_URL=
DONATE_URL=

# ── Rate limit ──
RATE_LIMIT_ENABLED=true

# Скопируй этот файл как .env и заполни значения.
# .env в git НЕ коммитится — туда клади настоящие токены.
# Этот файл (.env.example) — публичный шаблон, никогда не вписывай сюда секреты.

# Токен от @BotFather. Создаёшь бота → копируешь сюда.
BOT_TOKEN=

# SOCKS5/HTTP прокси к Telegram. V2RayTun по умолчанию слушает 10808.
# Если порт другой — посмотри в настройках V2RayTun (Local Setting → SOCKS port).
# Можно оставить пустым — тогда бот пойдёт напрямую (если у тебя нет блокировок).
PROXY_URL=socks5://127.0.0.1:10808

# Порт для admin-приложения. По умолчанию открывается в браузере.
ADMIN_PORT=8088

# 1 — открыть браузер автоматически при старте. 0 — не открывать.
ADMIN_OPEN_BROWSER=1

# Telegram user_id админа (твой). На /id у бота получишь свой.
# Только admin может выполнять команды через UI.
ADMIN_USER_ID=

*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
:root{--bg:#020617;--bg-deep:#060a1a;--surface:rgba(15,23,42,0.5);--border:rgba(255,255,255,0.08);--border-strong:rgba(255,255,255,0.13);--primary:#a855f7;--primary2:#7c3aed;--text:#f1f5f9;--sub:#94a3b8;--red:#f43f5e;--blue:#3b82f6;}
html{background:var(--bg);scroll-behavior:smooth}
body{background:transparent;color:var(--text);font-family:'Inter',sans-serif;overflow-x:hidden;padding-top:calc(var(--header-h,56px) + env(safe-area-inset-top));padding-bottom:calc(68px + env(safe-area-inset-bottom));min-height:100vh;position:relative;--header-h:56px;}
body.feed-mode{--header-h:100px;}
body::before{content:"";position:fixed;inset:0;z-index:-1;background:radial-gradient(80% 60% at 20% 0%,rgba(124,58,237,0.15),transparent 60%),radial-gradient(70% 60% at 100% 100%,rgba(168,85,247,0.10),transparent 60%),linear-gradient(180deg,var(--bg-deep),var(--bg));}
#mesh-bg{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none}

/* ── AUTH SCREEN ── */
#authScreen{position:fixed;inset:0;z-index:500;display:flex;align-items:center;justify-content:center;padding:24px;overflow-y:auto;}
.auth-card{width:100%;max-width:400px;background:rgba(9,14,30,0.92);backdrop-filter:blur(30px);-webkit-backdrop-filter:blur(30px);border:1px solid var(--border-strong);border-radius:24px;padding:36px 28px 32px;}
.auth-logo{font-size:30px;font-weight:800;letter-spacing:0.5px;background:linear-gradient(90deg,var(--primary),var(--primary2));-webkit-background-clip:text;-webkit-text-fill-color:transparent;text-align:center;margin-bottom:6px;}
.auth-tagline{text-align:center;color:#475569;font-size:13px;margin-bottom:28px;}
.auth-tabs{display:flex;background:rgba(2,6,23,0.6);border-radius:12px;padding:4px;margin-bottom:24px;gap:4px;}
.auth-tab{flex:1;padding:9px;border:none;border-radius:9px;background:transparent;color:var(--sub);font-size:14px;font-weight:600;cursor:pointer;transition:all 0.2s;font-family:'Inter',sans-serif;}
.auth-tab.active{background:rgba(168,85,247,0.15);color:var(--primary);border:1px solid rgba(168,85,247,0.25);}
.auth-input{width:100%;background:rgba(2,6,23,0.7);border:1px solid var(--border-strong);border-radius:12px;padding:13px 16px;color:var(--text);font-size:15px;font-family:'Inter',sans-serif;outline:none;transition:border-color 0.2s;margin-bottom:10px;display:block;}
.auth-input:focus{border-color:rgba(168,85,247,0.5);}
.auth-input::placeholder{color:#334155}
.auth-btn{width:100%;padding:14px;border-radius:12px;border:none;background:linear-gradient(90deg,var(--primary),var(--primary2));color:#fff;font-size:15px;font-weight:700;font-family:'Inter',sans-serif;cursor:pointer;margin-top:6px;transition:opacity 0.2s;}
.auth-btn:disabled{opacity:0.4;cursor:not-allowed;}
.auth-btn.ghost{background:transparent;border:1px solid var(--border-strong);color:var(--sub);margin-top:8px;font-weight:600;}
.auth-btn.ghost:hover{background:rgba(255,255,255,0.04);color:var(--text);}
.guest-block{padding:36px 22px;text-align:center;background:var(--surface);border:1px solid var(--border-strong);border-radius:18px;margin-bottom:14px;}
.guest-block i{font-size:34px;color:var(--primary);margin-bottom:14px;display:block;}
.guest-block h3{font-size:18px;font-weight:700;margin-bottom:8px;}
.guest-block p{font-size:14px;color:var(--sub);line-height:1.55;margin-bottom:22px;}
.guest-block .actions{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;}
.guest-block button{padding:11px 22px;border-radius:11px;border:none;font-family:'Inter',sans-serif;font-size:14px;font-weight:700;cursor:pointer;}
.guest-block .primary{background:linear-gradient(90deg,var(--primary),var(--primary2));color:#fff;}
.guest-block .secondary{background:transparent;border:1px solid var(--border-strong);color:var(--text);}
.auth-error{color:var(--red);font-size:13px;text-align:center;margin-top:10px;min-height:18px;line-height:1.4;}
.auth-hint{font-size:12px;color:#334155;margin-bottom:4px;margin-top:-4px;}

/* ── MAIN APP ── */
header{position:fixed;top:0;left:0;right:0;background:rgba(2,6,23,0.78);backdrop-filter:blur(22px) saturate(140%);-webkit-backdrop-filter:blur(22px) saturate(140%);border-bottom:1px solid var(--border);z-index:100;display:flex;flex-direction:column;}
.header-top{min-height:56px;display:flex;align-items:center;justify-content:space-between;padding:env(safe-area-inset-top) 16px 0;}
.header-logo{font-size:17px;font-weight:800;letter-spacing:0.5px;background:linear-gradient(90deg,var(--primary),var(--primary2));-webkit-background-clip:text;-webkit-text-fill-color:transparent;}
.header-brand{display:flex;align-items:center;gap:8px;font-size:15px;font-weight:800;padding:6px 10px;}
.header-brand span{background:linear-gradient(90deg,var(--primary),var(--primary2));-webkit-background-clip:text;-webkit-text-fill-color:transparent;letter-spacing:0.3px;}
/* min-width:0 разрешает флекс-элементу сжаться меньше суммарной ширины детей;
   overflow-x:auto — гарантированная прокрутка вместо обрезания за край экрана
   (body{overflow-x:hidden} иначе просто прячет всё, что не влезло, например
   кнопки "Поделиться"/бургер, добавленные позже пилюли с балансом и аватарки). */
.header-right{display:flex;align-items:center;gap:10px;min-width:0;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch;}
.header-right::-webkit-scrollbar{display:none;}
.header-right>*{flex-shrink:0;}
.new-pill{display:none;align-items:center;gap:6px;background:rgba(168,85,247,0.12);border:1px solid rgba(168,85,247,0.3);color:var(--primary);font-size:12px;font-weight:600;padding:5px 12px;border-radius:999px;cursor:pointer;transition:all 0.2s;}
.new-pill.show{display:flex}
.new-pill:active{background:rgba(168,85,247,0.22)}
.h-avatar{width:30px;height:30px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--primary2));display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:#fff;cursor:pointer;box-shadow:0 4px 12px rgba(168,85,247,0.3);flex-shrink:0;}

/* Pill баланса Gost в шапке */
.gost-pill{display:inline-flex;align-items:center;gap:6px;background:linear-gradient(135deg,rgba(168,85,247,0.15),rgba(236,72,153,0.10));border:1px solid rgba(168,85,247,0.35);color:#e9d5ff;font-size:13px;font-weight:700;padding:5px 11px;border-radius:999px;cursor:pointer;font-family:inherit;transition:all 0.2s;}
.gost-pill:hover{background:linear-gradient(135deg,rgba(168,85,247,0.25),rgba(236,72,153,0.18));transform:translateY(-1px);}
.gost-pill i{font-size:12px;color:var(--primary);}
.gost-pill.bump{animation:gostBump 0.5s ease-out;}
@keyframes gostBump{0%{transform:scale(1);} 30%{transform:scale(1.25);background:linear-gradient(135deg,rgba(34,197,94,0.35),rgba(168,85,247,0.20));} 100%{transform:scale(1);}}

/* Кошелёк */
.wallet-cards{display:grid;grid-template-columns:1fr;gap:10px;margin-bottom:22px;}
@media (min-width:520px){.wallet-cards{grid-template-columns:1fr 1fr 1fr;}}
.wallet-card{background:rgba(15,23,42,0.6);border:1px solid var(--border-strong);border-radius:16px;padding:14px;position:relative;overflow:hidden;}
.wallet-card.locked{opacity:0.55;}
.wallet-card-gost{background:linear-gradient(135deg,rgba(168,85,247,0.18),rgba(236,72,153,0.10));border-color:rgba(168,85,247,0.4);}
.wallet-card-soul{background:linear-gradient(135deg,rgba(244,114,182,0.10),rgba(168,85,247,0.05));}
.wallet-card-prem{background:linear-gradient(135deg,rgba(251,191,36,0.10),rgba(168,85,247,0.05));}
.wc-head{display:flex;align-items:center;gap:8px;margin-bottom:8px;}
.wc-head i{font-size:16px;color:var(--primary);}
.wallet-card-soul .wc-head i{color:#ec4899;}
.wallet-card-prem .wc-head i{color:#fbbf24;}
.wc-name{font-size:14px;font-weight:700;flex:1;}
.wc-soon{font-size:9px;font-weight:700;background:rgba(100,116,139,0.3);color:#94a3b8;padding:2px 7px;border-radius:999px;text-transform:uppercase;letter-spacing:0.4px;}
.wc-balance{font-size:26px;font-weight:800;line-height:1;margin-bottom:6px;}
.wc-sub{font-size:11px;color:var(--sub);line-height:1.4;}

.wallet-section{margin-bottom:22px;}
.wallet-section-title{font-size:12px;font-weight:700;color:var(--sub);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:10px;padding:0 2px;}

.wallet-claim-btn{width:100%;display:flex;align-items:center;justify-content:center;gap:10px;background:linear-gradient(135deg,var(--primary),var(--primary2));color:#fff;border:0;border-radius:14px;padding:14px;font-size:15px;font-weight:700;cursor:pointer;font-family:inherit;box-shadow:0 6px 20px rgba(168,85,247,0.35);transition:transform 0.15s;}
.wallet-claim-btn:hover:not(:disabled){transform:translateY(-1px);}
.wallet-claim-btn:disabled{opacity:0.5;cursor:not-allowed;background:rgba(100,116,139,0.3);box-shadow:none;color:#94a3b8;}
.wallet-claim-hint{font-size:12px;color:var(--sub);text-align:center;margin-top:10px;}
.wallet-claim-hint span{color:var(--primary);font-weight:700;font-variant-numeric:tabular-nums;}

.wallet-sources{display:grid;grid-template-columns:1fr;gap:8px;}
@media (min-width:520px){.wallet-sources{grid-template-columns:1fr 1fr;}}
.wal-src{display:flex;align-items:center;gap:10px;background:rgba(15,23,42,0.45);border:1px solid var(--border);border-radius:12px;padding:10px 13px;font-size:13px;}
.wal-src i{width:24px;text-align:center;color:var(--primary);font-size:14px;}
.wal-src span{flex:1;color:var(--text);}
.wal-src b{font-weight:800;color:#22c55e;font-size:14px;}

.tx-item{display:flex;align-items:center;gap:11px;padding:11px 12px;border-bottom:1px solid var(--border);}
.tx-item:last-child{border-bottom:0;}
.tx-icon{width:34px;height:34px;border-radius:10px;background:rgba(168,85,247,0.12);display:flex;align-items:center;justify-content:center;color:var(--primary);font-size:14px;flex-shrink:0;}
.tx-body{flex:1;min-width:0;}
.tx-title{font-size:13px;font-weight:600;color:var(--text);margin-bottom:2px;}
.tx-meta{font-size:11px;color:var(--sub);}
.tx-amount{font-weight:800;font-size:14px;color:#22c55e;font-variant-numeric:tabular-nums;}
.tx-amount.neg{color:var(--red);}
.tx-empty{padding:24px;text-align:center;color:var(--sub);font-size:13px;}
nav{position:fixed;bottom:0;left:0;right:0;height:calc(68px + env(safe-area-inset-bottom));padding-bottom:env(safe-area-inset-bottom);background:rgba(2,6,23,0.92);backdrop-filter:blur(22px);-webkit-backdrop-filter:blur(22px);border-top:1px solid var(--border);display:flex;z-index:100;}
.nav-btn{flex:1;background:none;border:none;color:#475569;font-size:10px;font-weight:600;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;transition:color 0.2s;font-family:'Inter',sans-serif;}
.nav-btn i{font-size:19px}
.nav-btn.active{color:var(--primary)}
main{padding:16px 14px;max-width:620px;margin:0 auto;position:relative;z-index:1}
.screen{display:none}
.screen.active{display:block;animation:screenIn 0.28s cubic-bezier(0.32,0.72,0,1);}
@keyframes screenIn{
  from{opacity:0;transform:translateY(8px);}
  to{opacity:1;transform:translateY(0);}
}
@media (prefers-reduced-motion: reduce){
  .screen.active{animation:none;}
}
.loader{display:flex;flex-direction:column;align-items:center;justify-content:center;height:55vh;gap:14px}
.spinner{width:32px;height:32px;border:3px solid var(--border-strong);border-top-color:var(--primary);border-radius:50%;animation:spin 0.8s linear infinite}
.spinner-sm{width:20px;height:20px;border-width:2px}
@keyframes spin{to{transform:rotate(360deg)}}
.loader-text{color:var(--sub);font-size:14px}
/* фильтры теперь живут в шапке (второй ряд header). Никакого sticky/own background — наследуют blur шапки */
.filters{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;padding:0 14px 10px;}
.filters::-webkit-scrollbar{display:none}
body:not(.feed-mode) #headerFilters{display:none;}
/* Гостям не показываем «Для вас» — алгоритм бессмысленен без сессии */
body.guest-mode .filter-btn.foryou-btn{display:none;}
body.guest-mode .prof-action-btn[onclick*="openAlgoSettings"]{display:none;}
.filter-btn{flex-shrink:0;padding:7px 16px;border-radius:999px;border:1px solid var(--border-strong);background:transparent;color:var(--sub);font-size:13px;font-weight:600;cursor:pointer;transition:all 0.2s;font-family:'Inter',sans-serif;}
.filter-btn.active{background:linear-gradient(90deg,var(--primary),var(--primary2));border-color:transparent;color:#fff;}
/* «Для вас» — алгоритмическая лента, выделяется и без active */
.filter-btn.foryou-btn{background:linear-gradient(120deg,rgba(168,85,247,0.18),rgba(124,58,237,0.15));border-color:rgba(168,85,247,0.42);color:var(--primary);box-shadow:0 0 14px rgba(168,85,247,0.18);position:relative;overflow:hidden;}
.filter-btn.foryou-btn::after{content:"";position:absolute;inset:0;background:linear-gradient(120deg,transparent 30%,rgba(255,255,255,0.18) 50%,transparent 70%);transform:translateX(-100%);transition:transform 1.2s;}
.filter-btn.foryou-btn:hover::after{transform:translateX(100%);}
.filter-btn.foryou-btn.active{background:linear-gradient(120deg,var(--primary),var(--primary2));color:#fff;border-color:transparent;box-shadow:0 0 24px rgba(168,85,247,0.5);}
.filter-btn.foryou-btn .ico{filter:drop-shadow(0 0 4px rgba(168,85,247,0.5));}

/* ── ALGO SURVEY ── */
.survey-card{background:rgba(15,23,42,0.6);border:2px solid var(--border-strong);border-radius:14px;padding:14px;margin-bottom:10px;cursor:pointer;transition:all 0.2s;position:relative;}
.survey-card:active{transform:scale(0.98);}
.survey-card.picked{border-color:var(--primary);background:rgba(168,85,247,0.12);box-shadow:0 0 0 1px rgba(168,85,247,0.3);}
.survey-card.picked::after{content:"\f00c";font-family:"Font Awesome 6 Free";font-weight:900;position:absolute;top:10px;right:12px;width:22px;height:22px;border-radius:50%;background:var(--primary);color:#fff;font-size:11px;display:flex;align-items:center;justify-content:center;}
.survey-head{display:flex;align-items:center;gap:8px;margin-bottom:6px;font-size:12px;color:var(--sub);}
.survey-author{color:var(--primary);font-weight:600;}
.survey-text{font-size:14px;color:#cbd5e1;line-height:1.5;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;word-break:break-word;}

/* ── ALGO SETTINGS ── */
.algo-section{background:var(--surface);backdrop-filter:blur(20px);border:1px solid var(--border-strong);border-radius:14px;padding:16px;margin-bottom:10px;}
.algo-section h4{font-size:14px;font-weight:700;margin-bottom:8px;color:var(--text);}
.algo-section .desc{font-size:12px;color:var(--sub);line-height:1.5;margin-bottom:10px;}
.algo-chips{display:flex;flex-wrap:wrap;gap:6px;}
.algo-chip{display:inline-flex;align-items:center;gap:6px;padding:5px 10px;border-radius:999px;background:rgba(168,85,247,0.1);border:1px solid rgba(168,85,247,0.25);color:var(--primary);font-size:12px;font-weight:600;}
.algo-chip .chip-w{color:var(--sub);font-weight:400;}
.algo-chip .chip-x{background:none;border:none;color:var(--sub);cursor:pointer;padding:0;margin-left:2px;font-size:11px;}
.algo-chip .chip-x:hover{color:var(--red);}
.algo-empty{font-size:12px;color:#475569;font-style:italic;}
.algo-stat-row{display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid var(--border);font-size:13px;}
.algo-stat-row:last-child{border-bottom:none;}
.algo-stat-row b{color:var(--primary);}
.post-card{background:var(--surface);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border:1px solid var(--border);border-radius:14px;padding:14px;margin-bottom:10px;position:relative;transition:border-color 0.15s;}
.post-card:hover{border-color:var(--border-strong);}
.new-dot{position:absolute;top:14px;right:14px;width:8px;height:8px;border-radius:50%;background:var(--blue);box-shadow:0 0 8px var(--blue);transition:opacity 0.4s;}
.post-header{display:flex;align-items:center;gap:10px;margin-bottom:10px;cursor:pointer}
.post-av{width:36px;height:36px;border-radius:50%;flex-shrink:0;background:linear-gradient(135deg,var(--primary),var(--primary2));display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;color:#fff;}
.post-info{flex:1;min-width:0}
.post-name{font-size:14px;font-weight:600;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
/* бейджики роль/верификация/премиум — маленькие иконки сразу за именем, везде одинаковые */
.user-badges{display:inline-flex;align-items:center;gap:3px;margin-left:4px;vertical-align:middle;}
.user-badges i{font-size:0.85em;}
.user-badges .ub-admin{color:#fbbf24;}
.user-badges .ub-mod{color:#60a5fa;}
.user-badges .ub-premium{color:var(--primary);}
/* верификация — розетка-галочка (не круглая, как в X/Instagram), а не просто иконка:
   12-лучевая звезда через clip-path, синий фон, белая галочка внутри */
.user-badges .ub-verified{
  display:inline-flex;align-items:center;justify-content:center;
  width:1.05em;height:1.05em;
  background:#1d9bf0;
  clip-path:polygon(50% 0%,61% 7%,74% 2%,80% 14%,93% 17%,91% 30%,100% 40%,91% 50%,100% 60%,91% 70%,93% 83%,80% 86%,74% 98%,61% 93%,50% 100%,39% 93%,26% 98%,20% 86%,7% 83%,9% 70%,0% 60%,9% 50%,0% 40%,9% 30%,7% 17%,20% 14%,26% 2%,39% 7%);
}
.user-badges .ub-verified i{color:#fff;font-size:0.55em;}
.post-user{font-size:12px;color:#475569;margin-top:1px}
.post-time{font-size:11px;color:#475569;flex-shrink:0}
.post-follow-btn{flex-shrink:0;display:inline-flex;align-items:center;gap:5px;padding:5px 11px;border-radius:999px;border:1px solid rgba(168,85,247,0.4);background:rgba(168,85,247,0.1);color:var(--primary);font-size:12px;font-weight:600;cursor:pointer;font-family:'Inter',sans-serif;transition:all 0.18s;}
.post-follow-btn:hover{background:rgba(168,85,247,0.2);}
.post-follow-btn:active{transform:scale(0.95);}
.post-follow-btn i{font-size:10px;}
.post-follow-btn.following{background:transparent;color:var(--sub);border-color:var(--border-strong);}
.post-mine-label{flex-shrink:0;font-size:11px;color:#475569;opacity:0.55;font-style:italic;letter-spacing:0.3px;}
.post-edited{font-size:10px;color:#475569;opacity:0.7;margin-left:4px;font-style:italic;}
.post-read-time{font-size:11px;color:#475569;opacity:0.65;display:inline-flex;align-items:center;gap:4px;margin-left:8px;}
.post-read-time i{font-size:9px;}

/* ── LINK PREVIEW ── */
.link-preview{display:flex;background:rgba(15,23,42,0.6);border:1px solid var(--border-strong);border-radius:12px;overflow:hidden;text-decoration:none;color:inherit;margin-bottom:12px;cursor:pointer;transition:border-color 0.18s;}
.link-preview:hover{border-color:rgba(168,85,247,0.4);}
.link-preview-img{width:100px;min-height:90px;background-size:cover;background-position:center;background-color:#0f172a;flex-shrink:0;}
.link-preview-body{padding:10px 12px;flex:1;min-width:0;display:flex;flex-direction:column;justify-content:center;gap:3px;}
.link-preview-site{font-size:11px;color:var(--primary);text-transform:uppercase;letter-spacing:0.4px;font-weight:600;}
.link-preview-title{font-size:14px;font-weight:700;color:var(--text);overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;line-height:1.3;}
.link-preview-desc{font-size:12px;color:var(--sub);overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;line-height:1.4;}
.link-preview-loading{display:flex;align-items:center;gap:10px;background:rgba(15,23,42,0.4);border:1px solid var(--border);border-radius:12px;padding:10px 12px;margin-bottom:12px;color:var(--sub);font-size:12px;}
.link-preview-loading .spinner-sm{width:14px;height:14px;border-width:2px;}

/* ── POLL ── */
.poll{background:rgba(15,23,42,0.55);border:1px solid var(--border-strong);border-radius:14px;padding:14px;margin-bottom:12px;}
.poll-q{font-size:15px;font-weight:600;color:var(--text);margin-bottom:12px;line-height:1.4;display:flex;align-items:center;gap:8px;}
.poll-q .badge{font-size:10px;font-weight:700;color:var(--primary);background:rgba(168,85,247,0.15);padding:3px 8px;border-radius:999px;text-transform:uppercase;letter-spacing:0.5px;}
.poll-opt{position:relative;display:flex;align-items:center;gap:10px;width:100%;padding:11px 14px;margin-bottom:7px;background:rgba(2,6,23,0.55);border:1px solid var(--border-strong);border-radius:10px;cursor:pointer;color:var(--text);font-size:14px;font-family:inherit;text-align:left;overflow:hidden;transition:all 0.18s;}
.poll-opt:not(.voted):hover{border-color:rgba(168,85,247,0.45);background:rgba(168,85,247,0.06);}
.poll-opt.voted{cursor:default;}
.poll-opt.voted.mine{border-color:rgba(168,85,247,0.6);}
.poll-opt.voted.correct{border-color:rgba(74,222,128,0.6);}
.poll-opt.voted.wrong{border-color:rgba(244,63,94,0.55);}
.poll-opt-fill{position:absolute;left:0;top:0;bottom:0;background:rgba(168,85,247,0.16);transition:width 0.5s cubic-bezier(.18,.89,.32,1.28);z-index:0;pointer-events:none;}
.poll-opt.voted.mine .poll-opt-fill{background:rgba(168,85,247,0.28);}
.poll-opt.voted.correct .poll-opt-fill{background:rgba(74,222,128,0.22);}
.poll-opt.voted.wrong .poll-opt-fill{background:rgba(244,63,94,0.18);}
.poll-opt-label{position:relative;z-index:1;flex:1;min-width:0;}
.poll-opt-pct{position:relative;z-index:1;font-size:12px;font-weight:700;color:var(--sub);min-width:38px;text-align:right;flex-shrink:0;}
.poll-opt-icon{position:relative;z-index:1;font-size:14px;flex-shrink:0;width:16px;text-align:center;}
.poll-opt-icon.ok{color:var(--green);}
.poll-opt-icon.bad{color:var(--red);}
.poll-total{font-size:11px;color:#475569;margin-top:6px;text-align:right;}

/* ── POLL EDITOR (в create) ── */
.poll-editor{background:rgba(15,23,42,0.55);border:1px solid var(--border-strong);border-radius:12px;padding:12px;margin-top:10px;}
.poll-editor-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;}
.poll-editor-title{font-size:13px;font-weight:700;color:var(--primary);}
.poll-editor input[type="text"]{width:100%;background:rgba(2,6,23,0.55);border:1px solid var(--border-strong);border-radius:8px;padding:9px 12px;color:var(--text);font-size:13px;font-family:inherit;margin-bottom:6px;outline:none;}
.poll-editor input[type="text"]:focus{border-color:rgba(168,85,247,0.5);}
.poll-opt-row{display:flex;gap:6px;align-items:center;margin-bottom:6px;}
.poll-opt-row input{flex:1;margin:0 !important;}
.poll-opt-row .quiz-check{flex-shrink:0;width:30px;height:30px;border-radius:50%;border:1.5px solid var(--border-strong);background:transparent;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--sub);transition:all 0.15s;}
.poll-opt-row .quiz-check.checked{border-color:var(--green);background:rgba(74,222,128,0.15);color:var(--green);}
.poll-opt-row .opt-del{flex-shrink:0;background:none;border:none;color:#475569;cursor:pointer;padding:6px;font-size:13px;}
.poll-opt-row .opt-del:hover{color:var(--red);}
.poll-editor-actions{display:flex;gap:8px;margin-top:6px;align-items:center;}
.poll-add-opt{padding:6px 12px;background:transparent;border:1px dashed var(--border-strong);border-radius:8px;color:var(--sub);font-size:12px;cursor:pointer;font-family:inherit;}
.poll-add-opt:hover{color:var(--text);border-color:rgba(168,85,247,0.4);}
.poll-quiz-toggle{display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--sub);cursor:pointer;user-select:none;margin-left:auto;}
.poll-quiz-toggle input{cursor:pointer;}
.poll-remove{background:none;border:none;color:#475569;cursor:pointer;font-size:12px;padding:4px;}
.poll-remove:hover{color:var(--red);}

/* ── DOUBLE-TAP HEART ── */
.post-card{position:relative;}
.dt-heart{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%) scale(0.5);font-size:90px;color:#fff;pointer-events:none;opacity:0;z-index:60;text-shadow:0 8px 30px rgba(244,63,94,0.65);}
.dt-heart.go{animation:dtBloom 0.85s cubic-bezier(.18,.89,.32,1.28) forwards;}
@keyframes dtBloom{
  0%{opacity:0;transform:translate(-50%,-50%) scale(0.4);}
  25%{opacity:1;transform:translate(-50%,-50%) scale(1.2);}
  60%{opacity:1;transform:translate(-50%,-50%) scale(1.0);}
  100%{opacity:0;transform:translate(-50%,-50%) scale(1.4);}
}

/* ── PULL-TO-REFRESH ── */
.ptr-indicator{position:fixed;top:var(--header-h,56px);left:50%;transform:translateX(-50%) translateY(-100%);width:40px;height:40px;border-radius:50%;background:rgba(168,85,247,0.18);border:1px solid rgba(168,85,247,0.4);display:flex;align-items:center;justify-content:center;color:var(--primary);font-size:16px;z-index:95;backdrop-filter:blur(10px);transition:transform 0.2s,opacity 0.2s;opacity:0;}
.ptr-indicator.show{opacity:1;}
.ptr-indicator.spin i{animation:spin 0.8s linear infinite;}
.post-content{font-size:15px;line-height:1.6;color:#cbd5e1;word-break:break-word;margin-bottom:12px;white-space:pre-wrap}
.post-media{margin-bottom:12px;display:flex;flex-direction:column;gap:8px;}

/* ── NSFW: блюр поста до клика «Показать» ── */
.post-card.nsfw .nsfw-blurable{filter:blur(22px);transition:filter 0.35s ease;pointer-events:none;user-select:none;}
.post-card.nsfw.revealed .nsfw-blurable{filter:none;pointer-events:auto;user-select:auto;}
.nsfw-overlay{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;z-index:5;background:rgba(15,23,42,0.55);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);border-radius:14px;cursor:pointer;transition:opacity 0.25s;}
.post-card.nsfw.revealed .nsfw-overlay{opacity:0;pointer-events:none;}
.nsfw-overlay-badge{display:inline-flex;align-items:center;gap:6px;padding:6px 14px;background:rgba(248,113,113,0.18);border:1px solid rgba(248,113,113,0.45);color:#f87171;border-radius:99px;font-size:11px;font-weight:700;letter-spacing:1px;}
.nsfw-overlay-text{color:var(--text);font-size:13px;font-weight:600;}
.nsfw-overlay-cta{margin-top:4px;padding:8px 18px;background:rgba(168,85,247,0.18);border:1px solid rgba(168,85,247,0.4);color:var(--primary);border-radius:10px;font-size:12px;font-weight:700;cursor:pointer;}
.nsfw-badge-header{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;margin-left:8px;background:rgba(248,113,113,0.15);border:1px solid rgba(248,113,113,0.35);color:#f87171;border-radius:6px;font-size:10px;font-weight:700;letter-spacing:0.5px;text-transform:uppercase;vertical-align:middle;}
.nsfw-by-admin{color:#fbbf24;border-color:rgba(251,191,36,0.45);background:rgba(251,191,36,0.12);}

/* ── Репутация в профиле ── */
.rep-badge{margin:6px auto 8px;padding:5px 14px;border-radius:99px;font-size:11px;font-weight:700;letter-spacing:0.5px;text-transform:uppercase;display:inline-flex;align-items:center;gap:6px;}
.rep-badge.rep-good{background:rgba(74,222,128,0.12);border:1px solid rgba(74,222,128,0.35);color:#4ade80;}
.rep-badge.rep-mid{background:rgba(168,85,247,0.12);border:1px solid rgba(168,85,247,0.35);color:var(--primary);}
.rep-badge.rep-low{background:rgba(248,113,113,0.12);border:1px solid rgba(248,113,113,0.4);color:#f87171;}

/* ── Вкладки в профиле ── */
.prof-tabs{display:flex;gap:0;margin:14px 0 8px;border-bottom:1px solid var(--border);}
.prof-tab{flex:1;background:none;border:none;border-bottom:2px solid transparent;color:var(--sub);font-size:14px;font-weight:600;padding:12px 8px;cursor:pointer;font-family:inherit;transition:color 0.2s,border-color 0.2s;}
.prof-tab.active{color:var(--primary);border-bottom-color:var(--primary);}
.prof-tab:hover:not(.active){color:var(--text);}

/* ── Share Sheet ── */
.share-contact{flex-shrink:0;background:none;border:none;cursor:pointer;font-family:inherit;display:flex;flex-direction:column;align-items:center;gap:6px;padding:4px;border-radius:12px;transition:background 0.15s;}
.share-contact-av{width:54px;height:54px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--primary2));display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:18px;border:2px solid transparent;transition:border-color 0.2s,transform 0.15s;}
.share-contact-name{font-size:11px;color:var(--sub);max-width:64px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.share-contact.selected .share-contact-av{border-color:var(--primary);transform:scale(0.92);}
.share-contact.selected .share-contact-name{color:var(--primary);font-weight:700;}
.share-ext{flex:1;min-width:calc(50% - 4px);padding:10px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.10);border-radius:12px;color:var(--text);font-size:13px;font-weight:600;text-decoration:none;display:flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;font-family:inherit;}
.share-ext i{font-size:16px;}
.share-ext:hover{background:rgba(168,85,247,0.10);}
#repostBtn.reposted{background:rgba(74,222,128,0.10)!important;border-color:rgba(74,222,128,0.30)!important;color:#4ade80!important;}

/* ── Мозаика репостов в профиле ── */
.repost-mosaic{padding:14px;}
.mosaic-header{display:flex;align-items:center;gap:8px;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.6px;color:var(--primary);margin-bottom:10px;}
.mosaic-grid{display:grid;gap:3px;border-radius:12px;overflow:hidden;}
.mosaic-cell{height:100px;background:rgba(15,23,42,0.85);border:1px solid rgba(255,255,255,0.05);position:relative;overflow:hidden;cursor:pointer;text-decoration:none;display:flex;flex-direction:column;justify-content:space-between;padding:8px;transition:transform 0.15s,border-color 0.15s;background-size:cover;background-position:center;}
.mosaic-cell:hover{transform:scale(1.03);border-color:rgba(168,85,247,0.4);z-index:2;}
.mosaic-cell.nsfw{background:linear-gradient(135deg,rgba(248,113,113,0.18),rgba(124,58,237,0.10));border-color:rgba(248,113,113,0.30);}
.mosaic-text{font-size:11px;line-height:1.3;color:var(--text);overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;}
.mosaic-author{font-size:10px;color:var(--sub);font-weight:600;align-self:flex-end;background:rgba(0,0,0,0.55);padding:2px 6px;border-radius:6px;backdrop-filter:blur(4px);}
.mosaic-nsfw{position:absolute;top:6px;left:6px;background:rgba(248,113,113,0.85);color:#fff;font-size:9px;font-weight:800;padding:2px 6px;border-radius:6px;letter-spacing:0.5px;}
.mosaic-cell.mosaic-more{background:linear-gradient(135deg,rgba(168,85,247,0.20),rgba(124,58,237,0.10));color:var(--primary);font-size:18px;font-weight:800;align-items:center;justify-content:center;text-align:center;line-height:1.2;text-decoration:none;}
.mosaic-cell.mosaic-more small{font-size:10px;font-weight:600;color:var(--sub);text-transform:uppercase;letter-spacing:0.5px;}
.mosaic-img,.mosaic-video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0;pointer-events:none;}
.mosaic-img.failed,.mosaic-video.failed{display:none;}
.mosaic-blur{filter:blur(22px);transform:scale(1.1);}  /* +scale чтоб не было видно белых краёв */
.mosaic-cell.has-media{background:linear-gradient(135deg,rgba(15,23,42,0.95),rgba(30,41,59,0.9));}
.mosaic-cell.has-media::before{content:"\f1c5";font-family:"Font Awesome 6 Free";font-weight:900;position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:rgba(168,85,247,0.25);font-size:36px;pointer-events:none;z-index:-1;}
.mosaic-video-icon{position:absolute;top:6px;right:6px;width:24px;height:24px;border-radius:50%;background:rgba(0,0,0,0.6);color:#fff;display:flex;align-items:center;justify-content:center;font-size:9px;z-index:1;pointer-events:none;}
.mosaic-nsfw-center{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:rgba(248,113,113,0.55);font-size:38px;pointer-events:none;}
.mosaic-cell.has-media .mosaic-author{position:relative;z-index:2;}
.mosaic-cell.has-media .mosaic-text{position:relative;z-index:2;}
.mosaic-cell.has-media .mosaic-nsfw{z-index:2;}
/* На крупных сетках (3x3+) ячейки меньше */
.mosaic-grid[style*="repeat(3"] .mosaic-cell,
.mosaic-grid[style*="repeat(4"] .mosaic-cell{height:90px;font-size:10px;}

/* ── Мини-стат бар поста (просмотры, репосты) ── */
.post-stats{display:flex;gap:14px;font-size:11px;color:var(--sub);padding:0 4px 8px;border-top:1px solid var(--border);padding-top:8px;margin-top:4px;}
.post-stats span{display:inline-flex;align-items:center;gap:4px;font-weight:500;}
.post-stats i{font-size:10px;opacity:0.7;}

/* ── Значок «репост» на карточке (теперь ссылка на исходный пост в ленте) ── */
.repost-mark{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:var(--primary);background:rgba(168,85,247,0.10);border:1px solid rgba(168,85,247,0.25);padding:3px 10px;border-radius:99px;margin-bottom:8px;text-decoration:none;cursor:pointer;transition:background 0.15s,border-color 0.15s;}
.repost-mark:hover{background:rgba(168,85,247,0.18);border-color:rgba(168,85,247,0.4);}

/* ── Пилюля «X контактов репостнули» ── */
.repost-pill{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;background:rgba(74,222,128,0.10);border:1px solid rgba(74,222,128,0.25);color:#4ade80;border-radius:99px;font-size:11px;font-weight:600;margin-left:8px;cursor:default;}
.repost-pill-av{width:18px;height:18px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--primary2));display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:10px;}

/* ── Daily status (под аватаром в профиле) ── */
.daily-status{margin:8px auto 4px;padding:8px 14px;border-radius:12px;background:rgba(168,85,247,0.08);border:1px solid rgba(168,85,247,0.20);color:var(--text);font-size:13px;line-height:1.4;font-style:italic;max-width:360px;text-align:center;}
.daily-status::before{content:'"';color:var(--primary);font-weight:800;margin-right:4px;}
.daily-status::after{content:'"';color:var(--primary);font-weight:800;margin-left:4px;}
.media-grid{display:grid;gap:3px;border-radius:12px;overflow:hidden;}
.media-grid.g1{grid-template-columns:1fr;}
.media-grid.g2{grid-template-columns:1fr 1fr;}
.media-grid.g3{grid-template-columns:1fr 1fr;grid-template-rows:auto auto;}
.media-grid.g3 .mg-item:first-child{grid-column:1/-1;}
.media-grid.g4{grid-template-columns:1fr 1fr;}
.media-grid.g5{grid-template-columns:1fr 1fr 1fr;grid-template-rows:auto auto;}
.mg-item{position:relative;background:#0f172a;overflow:hidden;cursor:pointer;aspect-ratio:1;}
.mg-item img,.mg-item video{width:100%;height:100%;object-fit:cover;display:block;}
.mg-item.tall{aspect-ratio:16/9;}
.media-video-wrap{border-radius:12px;overflow:hidden;cursor:pointer;position:relative;background:#0f172a;}
.video-play-overlay{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.12);}
.video-play-btn{width:56px;height:56px;border-radius:50%;background:rgba(168,85,247,0.85);display:flex;align-items:center;justify-content:center;backdrop-filter:blur(4px);}
.video-play-btn i{font-size:20px;color:#fff;margin-left:3px;}
.audio-widget{background:rgba(15,23,42,0.7);border:1px solid var(--border-strong);border-radius:12px;padding:12px 14px;display:flex;flex-direction:column;gap:8px;}
.audio-top{display:flex;align-items:center;gap:10px;}
.audio-play-btn{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--primary2));border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.audio-play-btn i{font-size:14px;color:#fff;margin-left:2px;}
.audio-play-btn.playing i{margin-left:0;}
.audio-waveform{flex:1;height:32px;cursor:pointer;display:flex;align-items:center;gap:2px;min-width:0;}
.audio-bar{flex:1 1 0;background:rgba(168,85,247,0.22);border-radius:2px;transition:background 0.12s;min-width:0;}
.audio-bar.played{background:var(--primary);}
.audio-time{font-size:11px;color:var(--sub);text-align:left;}
.post-footer{display:flex;align-items:center;gap:4px;border-top:1px solid var(--border);padding-top:10px;flex-wrap:wrap;}
.post-meta-stats{margin-left:auto;display:flex;gap:10px;font-size:11px;color:var(--sub);}
.post-meta-stats span{display:inline-flex;align-items:center;gap:4px;}
.act-btn{display:flex;align-items:center;gap:6px;background:none;border:none;color:var(--sub);font-size:13px;font-weight:600;cursor:pointer;padding:6px 10px;border-radius:10px;transition:all 0.2s;font-family:'Inter',sans-serif;}
.act-btn i{font-size:16px;transition:transform 0.15s}
.act-btn:active{background:rgba(255,255,255,0.05)}
.act-btn.liked{color:var(--red)}
.act-btn.liked i{transform:scale(1.15)}
.act-btn.del-btn{margin-left:auto;color:#334155;}
.act-btn.del-btn:hover{color:var(--red);}

/* ── CREATE ── */
.create-card{background:var(--surface);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border:1px solid var(--border-strong);border-radius:16px;padding:16px;margin-bottom:14px;}
.create-card textarea{width:100%;background:transparent;border:none;outline:none;color:var(--text);font-size:15px;line-height:1.6;resize:none;min-height:90px;font-family:'Inter',sans-serif;}
.create-card textarea::placeholder{color:#334155}
.create-footer{display:flex;justify-content:space-between;align-items:center;margin-top:10px;border-top:1px solid var(--border);padding-top:10px}
.create-left{display:flex;align-items:center;gap:8px;}
.attach-btn{background:none;border:none;color:var(--sub);cursor:pointer;padding:6px;border-radius:8px;transition:color 0.2s;font-size:18px;}
.attach-btn:active{color:var(--primary)}
.attach-btn.attached{color:var(--primary);background:rgba(168,85,247,0.1);}
.char-count{font-size:12px;color:#475569}
.char-count.warn{color:#f59e0b}
.pub-btn{padding:8px 20px;border-radius:10px;border:none;cursor:pointer;background:linear-gradient(90deg,var(--primary),var(--primary2));color:#fff;font-size:14px;font-weight:700;font-family:'Inter',sans-serif;transition:opacity 0.2s;}
.pub-btn:disabled{opacity:0.35;cursor:not-allowed}
.media-preview-list{display:flex;flex-direction:column;gap:8px;margin-top:10px;border-top:1px solid var(--border);padding-top:10px;}
.media-preview-item{display:flex;align-items:center;gap:10px;background:rgba(15,23,42,0.6);border:1px solid var(--border);border-radius:10px;padding:10px 12px;}
.media-preview-icon{width:36px;height:36px;border-radius:8px;background:rgba(168,85,247,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;position:relative;}
.media-preview-icon i{font-size:16px;color:var(--primary);}
.media-preview-info{flex:1;min-width:0;}
.media-preview-name{font-size:13px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.media-preview-size{font-size:11px;color:var(--sub);margin-top:2px;}
.media-preview-del{background:none;border:none;color:#475569;cursor:pointer;padding:6px;border-radius:6px;transition:color 0.2s;font-size:14px;}
.media-preview-del:active{color:var(--red);}
.attach-menu-overlay{position:fixed;inset:0;z-index:150;background:rgba(0,0,0,0.5);opacity:0;pointer-events:none;transition:opacity 0.2s;}
.attach-menu-overlay.open{opacity:1;pointer-events:all;}
.attach-menu{position:absolute;background:rgba(9,14,30,0.98);backdrop-filter:blur(20px);border:1px solid var(--border-strong);border-radius:16px;padding:8px;min-width:180px;box-shadow:0 20px 40px rgba(0,0,0,0.5);}
.attach-menu-item{display:flex;align-items:center;gap:10px;padding:12px 14px;border-radius:10px;cursor:pointer;transition:background 0.15s;font-size:14px;font-weight:600;}
.attach-menu-item:active{background:rgba(168,85,247,0.1);}
.attach-menu-item i{font-size:16px;color:var(--primary);width:20px;text-align:center;}

/* ── FULLSCREEN VIEWER ── */
.viewer-overlay{position:fixed;inset:0;background:#000;z-index:500;display:none;flex-direction:column;}
.viewer-overlay.open{display:flex;}

/* GhostSocial v11 patch — JS. Базируется на bak3 (рабочий v10). */

/* ============================================================
   v11a-1 — ссылки/юзеры/хэштеги: URL парсим первым (внутри URL # и @ не считаются)
   ============================================================ */
function linkifyContent(raw, hq){
  var html = (typeof highlightText === 'function') ? highlightText(raw, hq) : raw;
  // 1) URL целиком — вырезаем в плейсхолдеры, чтобы # и @ внутри не парсились
  var stash = [];
  html = html.replace(/(https?:\/\/[^\s<]+)/g, function(url){
    // не цепляем закрывающую пунктуацию в конце
    var tail = '';
    var m = url.match(/[)\].,!?;:]+$/);
    if (m){ tail = m[0]; url = url.slice(0, -tail.length); }
    var safe = url.replace(/"/g, '&quot;');
    var i = stash.length;
    stash.push('<a class="ext-link" href="' + safe + '" target="_blank" rel="noopener noreferrer nofollow" onclick="event.stopPropagation()">' + url + '</a>');
    return '\u0000L' + i + '\u0000' + tail;
  });
  // 2) хэштеги (в оставшемся тексте, без URL)
  html = html.replace(/(^|[^&\w])#([0-9A-Za-zА-Яа-яЁё_]{1,30})/gu,
    function(m, pre, tag){ return pre + '<a class="hashtag" href="#tag=' + encodeURIComponent(tag.toLowerCase()) + '" onclick="event.preventDefault();openTag(' + jsAttr(tag.toLowerCase()) + ')">#' + tag + '</a>'; });
  // 3) упоминания
  html = html.replace(/(^|[^&\w])@([a-z0-9._]{3,64})/g,
    function(m, pre, u){ return pre + '<a class="mention" href="#u=' + encodeURIComponent(u) + '" onclick="event.preventDefault();openFullProfile(' + jsAttr(u) + ')">@' + u + '</a>'; });
  // 4) возвращаем URL на место
  html = html.replace(/\u0000L(\d+)\u0000/g, function(_, i){ return stash[+i]; });
  return html;
}

/* ============================================================
   v11a — фикс шапки на не-ленте: прячем табы "Миниски|Посты" + фильтры
   и сжимаем высоту шапки (убирает пустую полосу на профиле и табы на логине).
   Логика: body.v11-offfeed = мы НЕ на ленте/минисках ИЛИ виден экран входа.
   ============================================================ */
(function(){
  function isOffFeed(){
    var auth = document.getElementById('authScreen');
    if (auth && getComputedStyle(auth).display !== 'none') return true; // экран входа
    var f = document.getElementById('screenFeed'), m = document.getElementById('screenMinisky');
    var onFeed = (f && f.classList.contains('active')) || (m && m.classList.contains('active'));
    return !onFeed;
  }
  function apply(){ document.body.classList.toggle('v11-offfeed', isOffFeed()); }
  function init(){
    var f = document.getElementById('screenFeed'), m = document.getElementById('screenMinisky');
    var auth = document.getElementById('authScreen');
    if (!f || !m){ return setTimeout(init, 400); }
    var obs = new MutationObserver(apply);
    obs.observe(f, { attributes:true, attributeFilter:['class'] });
    obs.observe(m, { attributes:true, attributeFilter:['class'] });
    if (auth) obs.observe(auth, { attributes:true, attributeFilter:['style','class'] });
    var sc = f.parentNode; if (sc) obs.observe(sc, { attributes:true, subtree:true, attributeFilter:['class'] });
    apply();
  }
  if (document.readyState !== 'loading') init(); else document.addEventListener('DOMContentLoaded', init);
})();


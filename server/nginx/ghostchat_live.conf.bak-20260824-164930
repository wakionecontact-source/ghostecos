limit_req_zone $binary_remote_addr zone=api_limit:10m rate=120r/m;
limit_req_zone $binary_remote_addr zone=login_limit:10m rate=5r/m;
limit_conn_zone $binary_remote_addr zone=conn_limit:10m;

# Браузерные запросы к API разрешены только с официальных origin GhostEcos.
# Пустой Origin оставляем для обычной навигации, мобильных клиентов и curl.
map $http_origin $ghostecos_bad_origin {
    default 1;
    "" 0;
    "https://ghostecos.duckdns.org" 0;
    "https://ghostchat.app" 0;
    "https://ghostchats.duckdns.org" 0;
    "https://ghostsocial.duckdns.org" 0;
    "https://ghostwallet.duckdns.org" 0;
}

# ── ПРОФИЛАКТИКА (весь UI, кроме лендинга) ──
# В профилактике доступ к статическим UI разрешён только доверенным IP.
# Cookie больше не является пропуском: любое значение cookie из браузера
# должно оставаться недействительным.
map $remote_addr $gs_maint {
    default   1;
    82.15.95.135  0;
    96.126.129.193 0;
}
map $remote_addr $gc_maint {
    default   1;
    82.15.95.135  0;
    96.126.129.193 0;
}

# Любой неизвестный HTTP Host, указывающий на этот сервер, отправляем на
# официальное предупреждение. Это не даёт чужому домену использовать vhost
# GhostEcos как свой сайт.
server {
    listen 80 default_server;
    server_name _;
    return 302 https://ghostecos.duckdns.org/security/phishing;
}

server {
    listen 80;
    server_name ghostecos.duckdns.org ghostchats.duckdns.org ghostsocial.duckdns.org ghostwallet.duckdns.org;
    include /etc/nginx/snippets/apkextrawaki.conf;
    return 301 https://$host$request_uri;
}

# Catch-all HTTPS: сертификат не соответствует чужому домену, но если клиент
# всё равно продолжил соединение, контент GhostEcos ему не отдаём.
server {
    listen 443 ssl http2 default_server;
    server_name _;
    ssl_certificate /etc/letsencrypt/live/ghostecos.duckdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ghostecos.duckdns.org/privkey.pem;
    return 302 https://ghostecos.duckdns.org/security/phishing;
}

server {
    listen 443 ssl http2;
    server_name ghostecos.duckdns.org ghostchats.duckdns.org ghostsocial.duckdns.org ghostwallet.duckdns.org;
    include /etc/nginx/snippets/apkextrawaki.conf;

    ssl_certificate /etc/letsencrypt/live/ghostecos.duckdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ghostecos.duckdns.org/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    client_max_body_size 160M;
    client_body_timeout 120s;
    client_header_timeout 30s;
    keepalive_timeout 15s;
    send_timeout 120s;

    # Fetch/XHR/WebSocket с постороннего сайта не получает доступ к API и
    # ресурсам экосистемы. Обычная навигация приходит без Origin.
    if ($ghostecos_bad_origin) { return 403; }

    if ($request_uri ~* "^.{300,}$") {
        return 444;
    }

    location ~ ^/(docs|redoc|openapi.json) {
        return 403;
    }

    location = /download/latest {
        proxy_pass http://127.0.0.1:8000/api/download/latest;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location = /download/ghostchattestlatest {
        return 404;
    }

    location /download/ {
        alias /opt/ghostchat/site/;
        types { application/vnd.android.package-archive apk; }
        default_type application/octet-stream;
    }

    location /api/login_request/ {
        limit_req zone=login_limit burst=2 nodelay;
        limit_conn conn_limit 2;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 10s;
        proxy_send_timeout 120s;
    }

    location /api/ {
        limit_req zone=api_limit burst=30 nodelay;
        limit_conn conn_limit 5;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }

    # Единый SSO-вход экосистемы. Эти страницы доступны и во время
    # профилактики продуктов, чтобы авторизация не зависела от их UI.
    location ^~ /auth/ {
        alias /var/www/ghostauth/;
        add_header Cache-Control "no-store, must-revalidate" always;
        include /etc/nginx/snippets/security_headers.conf;
    }
    location = /login/ { return 301 /login$is_args$args; }
    location = /register/ { return 301 /register$is_args$args; }
    location = /login {
        alias /var/www/ghostauth/login.html;
        default_type text/html;
        add_header Cache-Control "no-store, must-revalidate" always;
        include /etc/nginx/snippets/security_headers.conf;
    }
    location = /register {
        alias /var/www/ghostauth/register.html;
        default_type text/html;
        add_header Cache-Control "no-store, must-revalidate" always;
        include /etc/nginx/snippets/security_headers.conf;
    }
    location = /profile { return 301 /shop/profile$is_args$args; }
    location = /premium { return 301 /shop/premium$is_args$args; }

    # Статистика на коротком пути /statistics (страница shop :8001)
    location = /shop/statistics { return 301 /statistics; }
    location = /statistics/ { return 301 /statistics; }
    location = /statistics {
        proxy_pass http://127.0.0.1:8001/shop/statistics;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_read_timeout 30s;
    }

    location /shop/ {
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_read_timeout 30s;
    }

    location = /games {
        alias /opt/ghostchat/site/games.html;
        default_type text/html;
        add_header Cache-Control "no-store, must-revalidate";
        include /etc/nginx/snippets/security_headers.conf;
    }

    location = /security/phishing {
        alias /opt/ghostchat/site/phishing-warning.html;
        default_type text/html;
        add_header Cache-Control "no-store" always;
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
        include /etc/nginx/snippets/security_headers.conf;
    }

    location = /dialog.js {
        alias /opt/ghostchat/site/dialog.js;
        default_type application/javascript;
        add_header Cache-Control "public, max-age=600";
        include /etc/nginx/snippets/security_headers.conf;
    }

    location = /mesh.js {
        alias /opt/ghostchat/site/mesh.js;
        default_type application/javascript;
    }
    location = /liquid.css {
        alias /opt/ghostchat/site/liquid.css;
        default_type text/css;
        add_header Cache-Control 'public, max-age=300';
        include /etc/nginx/snippets/security_headers.conf;
    }

    location = /liquid.js {
        alias /opt/ghostchat/site/liquid.js;
        default_type application/javascript;
        add_header Cache-Control 'public, max-age=300';
        include /etc/nginx/snippets/security_headers.conf;
    }

    location = /social-aug.css {
        alias /opt/ghostchat/site/social-aug.css;
        default_type text/css;
        add_header Cache-Control 'public, max-age=300';
        include /etc/nginx/snippets/security_headers.conf;
    }

    location = /social-aug.js {
        alias /opt/ghostchat/site/social-aug.js;
        default_type application/javascript;
        add_header Cache-Control 'public, max-age=300';
        include /etc/nginx/snippets/security_headers.conf;
    }


    location = /api/soc/ws {
        # Браузер передаёт токен в query (WebSocket API не умеет custom headers).
        # До backend отправляем его заголовком и очищаем query, чтобы токен не
        # попадал в access-логи nginx/uvicorn.
        access_log off;
        proxy_set_header X-GS-Token $arg_token;
        proxy_pass http://127.0.0.1:8005/api/soc/ws?;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }
    location = /download/gc_test {
        return 404;
    }

    location /api/chat/ {
        proxy_pass http://127.0.0.1:8005;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_read_timeout 60s;
    }
    location /api/bots/ {
        proxy_pass http://127.0.0.1:8005;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_read_timeout 65s;
    }
    location /api/support-admin/ {
        proxy_pass http://127.0.0.1:8005;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_read_timeout 65s;
    }
    location /api/soc/upload {
        client_max_body_size 160M;
        proxy_pass http://127.0.0.1:8005;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
    location /api/soc/ {
        client_max_body_size 160M;
        proxy_send_timeout 120s;
        proxy_pass http://127.0.0.1:8005;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_read_timeout 30s;
    }

    # Наш новый роут для социальной сети
    # Admin-панель: отдельный файл, exact match (до /social — иначе перехватит)
    location = /__maint.html {
        internal;
        alias /var/www/ghostsocial/maintenance.html;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/security_headers.conf;
    }
    location = /social/__unlock {
        proxy_pass http://127.0.0.1:8005;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        include /etc/nginx/snippets/security_headers.conf;
    }
    location = /social/__lock {
        add_header Set-Cookie "gs_dev=; Path=/; Max-Age=0" always;
        include /etc/nginx/snippets/security_headers.conf;
        return 302 /social?dev=1;
    }
    location = /social/admin {
        allow 82.15.95.135;
        allow 96.126.129.193;
        deny all;
        error_page 403 =404 /404.html;
        alias /var/www/ghostsocial/admin.html;
        default_type text/html;
        add_header Cache-Control "no-store";
        include /etc/nginx/snippets/security_headers.conf;
    }
    location = /admin { return 301 /social/admin; }
    location = /admin/ { return 301 /social/admin; }

    location /media/ {
        alias /opt/ghostchat/media/;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        include /etc/nginx/snippets/security_headers.conf;
    }

    location /social/media/ {
        alias /var/www/ghostsocial/media/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security_headers.conf;
    }

    location /social/assets/ {
        alias /var/www/ghostsocial/assets/;
        include /etc/nginx/snippets/social_security_headers.conf;
    }
    location /social {
        error_page 503 /__chat_maint.html;
        if ($gs_maint) { return 503; }
        alias /var/www/ghostsocial/;
        index socialprotot.html;
        try_files $uri $uri/ /social/socialprotot.html;
        add_header Cache-Control "no-cache, must-revalidate" always;
        include /etc/nginx/snippets/social_security_headers.conf;
    }

    # Лендинг GhostChat — отдаём статикой из site-каталога (/opt/ghostchat/site/)
    location = /lend/ghostchat { return 301 /lend/ghostchat/; }
    location /lend/ghostchat/ {
        alias /opt/ghostchat/site/;
        index index.html;
        try_files $uri $uri/ /lend/ghostchat/index.html;
    }

    location = /favicon.png {
        alias /opt/ghostchat/site/favicon.png;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        include /etc/nginx/snippets/security_headers.conf;
        access_log off;
    }
    location = /apple-touch-icon.png {
        alias /opt/ghostchat/site/apple-touch-icon.png;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        include /etc/nginx/snippets/security_headers.conf;
        access_log off;
    }
    location = /favicon.jpg {
        alias /opt/ghostchat/site/favicon.jpg;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        include /etc/nginx/snippets/security_headers.conf;
        access_log off;
    }
    location = /favicon.ico {
        alias /opt/ghostchat/site/favicon.png;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        include /etc/nginx/snippets/security_headers.conf;
        access_log off;
    }
location = /ava.jpg {
        alias /opt/ghostchat/site/ava.jpg;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        include /etc/nginx/snippets/security_headers.conf;
    }
    location = /ava.png {
        alias /opt/ghostchat/site/ava.png;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        include /etc/nginx/snippets/security_headers.conf;
    }
    # Кастомная страница 404 (перехват 404 от бэкенда и от nginx)
    error_page 404 /404.html;
    location = /404.html {
        internal;
        alias /opt/ghostchat/site/404.html;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/security_headers.conf;
    }

    location = /bank { return 301 /bank/$is_args$args; }
    location = /bank/giveaway  { return 301 /bank/giveaway/$is_args$args; }
    location = /bank/giveaway/ {
        root /var/www;
        try_files /bank/giveaway/index.html =404;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/security_headers.conf;
    }
    location /bank/ {
        error_page 503 /__chat_maint.html;
        if ($gc_maint) { return 503; }
        root /var/www;
        index index.html;
        try_files $uri /bank/index.html;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/security_headers.conf;
    }

    location = /bank/manifest.json {
        alias /var/www/bank/manifest.json;
        add_header Cache-Control "no-store, must-revalidate";
        include /etc/nginx/snippets/security_headers.conf;
    }

    # Профилактика GhostChat web-клиента (переделка UI) — 503 всем кроме
    # владельца (cookie gs_dev, тот же что у /social/__unlock).
    location = /__chat_maint.html {
        internal;
        alias /var/www/ghostsocial/chat_maintenance.html;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/security_headers.conf;
    }

    # GhostChat web client (Flutter web). TEMP: access restricted to owner IP only.
    location = /chat { return 301 /chat/$is_args$args; }
    location /chat/ {
        error_page 503 /__chat_maint.html;
        if ($gc_maint) { return 503; }
        # ВРЕМЕННО открыт для всех (WARP мешал ограничению по IP). Закрыть позже basic-auth.
        root /var/www;          # serves /var/www/chat/...
        index index.html;
        # без $uri/ — иначе nginx пытается листить директорию и даёт 403 вместо index.html
        try_files $uri /chat/index.html;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/security_headers.conf;
    }

    # GhostNation — статическая игра (Leaflet + localStorage), отдаём из /var/www/nation/
    location = /nation { return 301 /nation/$is_args$args; }
    location /nation/ {
        error_page 503 /__chat_maint.html;
        if ($gc_maint) { return 503; }
        root /var/www;
        index index.html;
        try_files $uri /nation/index.html;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/security_headers.conf;
    }

    # GhostNation мультиплеер-API → uvicorn :8010 (как /api/soc → 8005)
    location /api/nation/ {
        client_max_body_size 2m;
        proxy_pass http://127.0.0.1:8010;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_read_timeout 30s;
    }


    # Закрытый dev-роут: только для моего IP, остальным 403.
    # /test/socialdiz — экспериментальный дизайн соц-сети (split + liquid glass)
    location /test/ {
        allow 82.15.95.135;
        allow 96.126.129.193;
        deny all;
        root /var/www;
        index index.html;
        try_files $uri $uri/ =404;
        add_header Cache-Control 'no-store, must-revalidate';
        include /etc/nginx/snippets/security_headers.conf;
    }

    # Домен-специфичные редиректы корня: ghostchats -> /chat/, ghostsocial -> /social
    location = / {
        if ($host = ghostchats.duckdns.org) { return 301 https://ghostecos.duckdns.org/chat/; }
        if ($host = ghostsocial.duckdns.org) { return 301 https://ghostecos.duckdns.org/social; }
        if ($host = ghostwallet.duckdns.org) { return 301 https://ghostecos.duckdns.org/bank/; }
        limit_conn conn_limit 10;
        proxy_intercept_errors on;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }

    # Legacy WebSocket clients send JWT/device_id as query parameters.  Move
    # them to private upstream headers and discard the query string so tokens
    # are not written to nginx access logs or propagated to the application.
    location = /ws {
        limit_conn conn_limit 10;
        access_log off;
        proxy_pass http://127.0.0.1:8000/ws?;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-GC-Token $arg_token;
        proxy_set_header X-GC-Device-Id $arg_device_id;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }

    location / {
        limit_conn conn_limit 10;
        proxy_intercept_errors on;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }

    location = /ghogem {
        return 301 /ghogem/$is_args$args;
    }
    location /ghogem/ {
        alias /var/www/ghogem/;
        try_files $uri $uri/ /ghogem/index.html;
        add_header Cache-Control "no-cache";
    }
    location /ghogem-api/ {
        proxy_pass http://127.0.0.1:8021/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
    }

    location = /ghosou {
        return 301 /sound/;
    }
    location ^~ /ghosou/ {
        return 301 /sound/;
    }
    location = /sound {
        return 301 /sound/;
    }
    location = /sound/ws {
        proxy_pass http://127.0.0.1:8030/sound/ws;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
        access_log off;
    }
    location /sound/ {
        error_page 503 /__maint.html;
        limit_conn conn_limit 10;
        limit_req zone=api_limit burst=60 nodelay;
        proxy_pass http://127.0.0.1:8030;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        client_max_body_size 65M;
        include /etc/nginx/snippets/security_headers.conf;
    }

}

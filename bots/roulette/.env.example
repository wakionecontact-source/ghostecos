# Скопируй этот файл как .env и заполни значения.
# .env в git НЕ коммитится — туда клади настоящие токены.
# Этот файл (.env.example) — публичный шаблон, никогда не вписывай сюда секреты.

# Токен от @BotFather. Создаёшь бота → копируешь сюда.
BOT_TOKEN=

# Прокси к Telegram. ПУСТО — если у тебя V2RayTun в TUN mode (захватывает
# весь системный трафик), то бот сам пойдёт через него без явного прокси.
# Если V2RayTun в "Manual proxy" режиме — поставь:
#   socks5://127.0.0.1:10808   (SOCKS-порт)
#   http://127.0.0.1:10809     (HTTP-порт)
PROXY_URL=


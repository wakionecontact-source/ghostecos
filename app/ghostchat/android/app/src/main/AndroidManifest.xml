        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- FCM: иконка для серверных push (иначе дефолтный белый квадрат). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <!-- FCM fallback channel uses the custom GhostChat notification tone. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="messages_ghost_v2" />
        <!-- Generic FCM-пуш отключён: оставляем одно уведомление от
             NotificationService, учитывающее настройки пользователя. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <!-- Иконка для persistent-уведомления foreground-сервиса. -->
        <meta-data
            android:name="online.ghost_chat.fg_notification_icon"
            android:resource="@drawable/ic_notification" />
        <!-- flutter_foreground_task: сервис «в сети» (Android 14+ требует type). -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
        <!-- Separate, short-lived service used only while the user shares the screen. -->
        <service
            android:name="de.julianassmann.flutter_background.IsolateHolderService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection"
            tools:replace="android:foregroundServiceType" />
        <!-- DownloadManager survives the Flutter process and notifies us when
             its one-use APK download ticket completes. -->
        <receiver
            android:name=".UpdateDownloadReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>
        <!-- BootReceiver used to start the plugin before Flutter/auth was
             ready. Session startup owns the service now; keep boot inert even
             when an older installed version persisted autoRunOnBoot=true. -->
        <receiver
            android:name="com.pravera.flutter_foreground_task.service.RebootReceiver"
            android:enabled="false"
            tools:node="replace" />
        <activity
            android:name=".UpdateInstallerActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true"
            tools:ignore="ExportedService" />
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver" />

[Unit]
Description=GhostEcos Core API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/ghostecos-core
EnvironmentFile=/etc/ghostecos/core.env
EnvironmentFile=-/etc/ghostecos/social-unlock.env
EnvironmentFile=-/etc/ghostchat/bot-check.env
EnvironmentFile=-/etc/ghostchat/bot-runner.env
EnvironmentFile=-/etc/ghostchat/ghostsocial-turn.env
ExecStart=/opt/ghostchat/venv/bin/uvicorn ecos_core_app:app --host 127.0.0.1 --port 8002 --workers 1 --no-server-header --proxy-headers
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

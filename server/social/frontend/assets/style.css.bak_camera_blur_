.modal-overlay.open{opacity:1;pointer-events:all}
.modal-sheet{background:rgba(6,10,26,0.98);backdrop-filter:blur(30px);-webkit-backdrop-filter:blur(30px);border:1px solid var(--border-strong);border-radius:24px 24px 0 0;padding:20px 20px 40px;width:100%;max-width:620px;transform:translateY(100%);transition:transform 0.3s cubic-bezier(0.32,0.72,0,1);}
.modal-overlay.open .modal-sheet{transform:translateY(0)}
/* v11c: #commentsModal — на десктопе .modal-overlay центрируется по ВСЕЙ ширине
   вьюпорта (inset:0 + justify-content:center), но реальный видимый контент
   смещён вправо от истинного центра окна из-за сайдбара 260px (см. #screenMinisky
   {left:260px} и .msk-overlay/.mskc-ftrack, центрированные УЖЕ внутри области после
   сайдбара). Из-за этого модалка при открытии из Миниски казалась не по центру
   относительно того, что видит юзер. Фикс: на >=1000px центр — середина области
   ПОСЛЕ сайдбара, а не всего окна. */
@media (min-width:1000px){
  #commentsModal{left:260px;}
}
/* v11q: комменты из Миниски на десктопе — плавающая карточка (YouTube Shorts
   стиль), а не панель на всю высоту у края. Центрируется по вертикали и лежит
   в свободном пространстве справа от видео (видео центрировано в области после
   сайдбара 260px, max-width 480px — см. .msk-card video/.mskc-ftrack выше).
   Правый край видео = 260 + ((100vw-260)-480)/2 + 480 = calc(370px + 50vw).
   Середина свободного места справа от видео = (правый край видео + 100vw)/2 =
   calc(185px + 75vw); для панели шириной 380px это даёт margin-left в виде
   calc(75vw - 5px). На узких десктопных ширинах (1000-1550px) эта формула
   уводит панель ЗА пределы экрана или на видео — поэтому центрирование включаем
   только от 1600px, а до этого панель просто прижата к правому краю с отступом. */
@media (min-width:1000px){
  body.miniska-mode #commentsModal{
    left:0; /* без сдвига под сайдбар — панель мерит себя от истинного правого края окна */
    align-items:center; /* по вертикали — по центру, не во всю высоту */
    justify-content:flex-end;
    background:transparent !important; /* без затемнения — видео остаётся живым слева; !important нужен, чтобы перебить liquid.css .modal-overlay{background:...!important} */
    backdrop-filter:none !important; /* liquid.css вешает blur(10px) на все .modal-overlay — тут он размывал видео за панелью */
    -webkit-backdrop-filter:none !important;
    pointer-events:none; /* клик мимо панели проходит насквозь к видео */
  }
  body.miniska-mode #commentsModal .modal-sheet{ pointer-events:auto; }
  body.miniska-mode #commentsModal .modal-sheet{
    width:380px;
    max-width:380px;
    height:76vh;
    max-height:660px;
    min-height:380px;
    border-radius:22px;
    padding:20px 20px 24px;
    display:flex;
    flex-direction:column;
    margin-right:40px; /* fallback до 1600px — карточка у края, но с отступом, не впритык */
    transform:translateX(30px);
    opacity:0;
    transition:transform 0.3s cubic-bezier(0.32,0.72,0,1), opacity 0.25s;
    border:1px solid var(--border-strong);
    box-shadow:0 20px 60px rgba(0,0,0,0.55);
    background:rgba(10,12,20,0.94) !important; /* liquid.css красит .modal-sheet в фиолетовое (rgba(20,14,40,.72)+saturate160%) — тут нейтральный тёмный без оттенка */
    backdrop-filter:blur(24px) !important;
    -webkit-backdrop-filter:blur(24px) !important;
  }
  body.miniska-mode #commentsModal.open .modal-sheet{
    transform:translateX(0);
    opacity:1;
  }
  body.miniska-mode #commentsModal .modal-handle{display:none;}
  body.miniska-mode #commentsModal #commentsList{flex:1;overflow-y:auto;}
}
/* v11q-wide: от 1600px свободного места справа от видео хватает, чтобы
   поставить карточку РОВНО по центру этого пространства (не просто у края
   с отступом) — считаем через calc по формуле из комментария выше. */
@media (min-width:1600px){
  body.miniska-mode #commentsModal{ justify-content:flex-start; }
  body.miniska-mode #commentsModal .modal-sheet{
    margin-right:0;
    margin-left:calc(75vw - 5px);
  }
}

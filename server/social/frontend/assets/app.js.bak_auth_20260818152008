  // все ли вложения уже загружены на сервер (можно публиковать без повторной загрузки)
  function allUploaded(){
    return media.length>0 && media.every(function(m){ return !!m.uploadedUrl; });
  }
  // склонение "файл/файла/файлов" по числу (1→файл, 2-4→файла, 5+→файлов, с учётом 11-14)
  function pluralFiles(n){
    var n10 = n%10, n100 = n%100;
    if (n10===1 && n100!==11) return 'файл';
    if (n10>=2 && n10<=4 && (n100<12 || n100>14)) return 'файла';
    return 'файлов';
  }
  // подписываем кнопку публикации по состоянию аплоада вложений:
  // - единственный файл грузится сейчас → анимированное "Загрузка..." (CSS-точки), кнопка заблокирована
  // - часть файлов грузится/готова, но есть ещё не начатые → "Загрузить файлы (N файла)", кликабельно
  // - всё загружено → "Опубликовать"
  // - иначе (ничего не грузится) → дефолт "Загрузить файлы"
  function updatePublishBtnLabel(){
    var btn = el('mskcPublish2'); if(!btn || publishing) return;
    var total = media.length;
    var uploadingCount = media.filter(function(m){ return !!m.uploading; }).length;
    var doneCount = media.filter(function(m){ return !!m.uploadedUrl; }).length;
    var pendingCount = total - uploadingCount - doneCount;

    if (total===1 && uploadingCount===1){
      btn.innerHTML = 'Загрузка<span class="mskc-btn-dots"><i></i><i></i><i></i></span>';
      btn.disabled = true;
    } else if (uploadingCount>0 && uploadingCount<total){
      btn.textContent = 'Загрузить файлы ('+pendingCount+' '+pluralFiles(pendingCount)+')';
      btn.disabled = false;
    } else if (doneCount===total){
      btn.textContent = 'Опубликовать';
      btn.disabled = false;
    } else {
      btn.textContent = 'Загрузить файлы';
      btn.disabled = false;
    }
  }
  function setFileProgress(i, pct, label){
    var card=el('mskcPubPreview') && el('mskcPubPreview').querySelector('.mskc-file[data-fi="'+i+'"]');
    if(!card) return;
    var fill=card.querySelector('.mskc-file-fill'), lb=card.querySelector('.mskc-file-label');
    if(fill && pct!=null) fill.style.width=Math.round(pct)+'%';
    if(lb && label!=null) lb.textContent=label;
    if(pct>=100 && fill) fill.classList.add('done');
  }
  // безопасный File для аплоада (из in-memory blob, чтоб не протух)
  // гарантируем СВЕЖИЕ данные файла (видео большое — blob мог не дочитаться → протух)
  function ensureUploadFile(m){
    function asFile(blob){
      try{ return new File([blob], m.name||('file'+(m.type==='video'?'.mp4':'.jpg')), {type:m.mime||''}); }
      catch(e){ return blob; }
    }
    if (m.blob) return Promise.resolve(asFile(m.blob));
    if (m.file && m.file.arrayBuffer){
      return m.file.arrayBuffer().then(function(buf){
        m.blob = new Blob([buf], {type:m.mime||''});
        return asFile(m.blob);
      });
    }
    return Promise.resolve(m.file);
  }

  // чистый аплоад одного файла через XHR (с прогрессом), без сторонних обёрток
  function uploadOne(item, onProg){
    function send(payload){
      return new Promise(function(resolve, reject){
        try{
          var fd = new FormData();
          fd.append('file', payload, item.name || ('file'+(item.type==='video'?'.mp4':'.jpg')));
          var xhr = new XMLHttpRequest();
          xhr.open('POST', API + '/upload');
          xhr.setRequestHeader('Authorization', 'Bearer ' + token);
          xhr.upload.onprogress = function(e){ if (e.lengthComputable && onProg) onProg(e.loaded/e.total); };
          xhr.onload = function(){
            if (xhr.status>=200 && xhr.status<300){
              try{ resolve(JSON.parse(xhr.responseText)); }
              catch(err){ reject(new Error('Битый ответ сервера')); }
            } else { reject(new Error('Загрузка: HTTP '+xhr.status)); }
          };
          xhr.onerror = function(){ reject(new Error('Сеть: запрос не дошёл (upload)')); };
          xhr.send(fd);
        }catch(err){ reject(err); }
      });
    }
    // используем готовый Blob; если не дочитался — читаем сейчас; иначе fallback на File
    if (item.blob){ return send(item.blob); }
    if (item.file && item.file.arrayBuffer){
      return item.file.arrayBuffer()
        .then(function(buf){ return send(new Blob([buf], { type:item.mime||'application/octet-stream' })); });
    }
    return send(item.file);
  }

  function setProg(pct){
    var p = el('mskcProgress'); if(!p) return;
    if (pct==null){ p.classList.remove('show'); return; }
    p.classList.add('show');
    el('mskcProgressVal').textContent = Math.round(pct) + '%';
    el('mskcProgressBar').style.width = Math.round(pct) + '%';
  }

  // v11d: публикация разбита на 2 явных шага — "Загрузить файлы" (только аплоад,
  // результат пишется в media[i].uploadedUrl) и отдельным нажатием "Опубликовать"
  // (сам POST /miniska/new_v2 по уже загруженным ссылкам). Пауза между шагами даёт
  // пользователю проверить/поправить подпись и хэштеги, не теряя загруженное.
  var publishing = false;

  // общая предпубликационная валидация — гоняем ДО начала аплоада, чтобы не тратить
  // трафик на файлы, если хэштегов не хватает
  function validateForPublish(){
    if (!media.length){ showToast('Нет вложений'); return null; }
    var tags = collectTags();
    if (tags.length < 3){ showToast('Минимум 3 хэштега'); return null; }
    return tags;
  }

  // ф3: аплоад ОДНОГО элемента media[i] — общая логика, переиспользуется и батч-аплоадом
  // (uploadAllFiles), и точечной кнопкой на карточке (renderPubPreview). onOverallProg
  // необязателен — батч использует его чтобы двигать общий прогресс-бар, одиночный
  // аплоад его не передаёт (у одиночного файла нет общего бара).
  function uploadOneMediaItem(i, onOverallProg){
    var m = media[i];
    if (m.uploadedUrl){ setFileProgress(i, 100, 'Готово'); return Promise.resolve(); }
    // ф-race: если для этого же элемента уже есть летящий аплоад (например, поштучная
    // кнопка запустила его, а потом до её завершения нажали общую "Загрузить файлы") —
    // НЕ стартуем второй параллельный запрос, а отдаём тот же промис. Оба вызывающих
    // пути (uploadAllFiles и uploadSingleFile) используют эту функцию, поэтому защита
    // общая и не требует отдельных проверок на местах вызова.
    if (m._inflight) return m._inflight;
    m.uploading = true;
    updatePublishBtnLabel();
    setFileProgress(i, 0, 'Загрузка 0%');
    var useUW = (typeof uploadWithProgress==='function');
    // СНАЧАЛА гарантируем свежий файл (видео могло не дочитаться), потом грузим
    var p = ensureUploadFile(m).then(function(file){
      if (useUW){
        var processing=false, finalizing=false;
        return uploadWithProgress(
          file,
          function(pct){
            if (onOverallProg) onOverallProg(pct);
            var lbl = finalizing ? 'Обработка…' : (processing ? ('Сжатие '+pct+'%') : ('Загрузка '+pct+'%'));
            setFileProgress(i, pct, lbl);
          },
          function(){ processing=true; },
          function(abortFn){ m._abort = abortFn; },
          function(){ finalizing=true; }
        ).then(function(data){
          if (!data || !data.url) throw new Error('Сервер не вернул ссылку');
          m.uploading = false; m._abort = null;
          setFileProgress(i, 100, 'Готово');
          m.uploadedUrl = data.url;
        });
      } else {
        return uploadOne(m, function(frac){
          if (onOverallProg) onOverallProg(frac*100);
          setFileProgress(i, frac*100, 'Загрузка '+Math.round(frac*100)+'%');
        }).then(function(data){
          if (!data || !data.url) throw new Error('Сервер не вернул ссылку');
          m.uploading = false; m._abort = null;
          setFileProgress(i, 100, 'Готово');
          m.uploadedUrl = data.url;
        });
      }
    }).catch(function(err){
      m.uploading = false; m._abort = null;
      throw err;
    });
    // очищаем метку "в полёте" при любом исходе, но САМ p (со значением/ошибкой) отдаём
    // вызывающим как есть — чистим только флаг, чтобы следующий клик мог начать новый аплоад
    p = p.then(function(res){ m._inflight = null; return res; }, function(err){ m._inflight = null; throw err; });
    m._inflight = p;
    return p;
  }

  // только аплоад всех ещё не загруженных файлов; уже загруженные (uploadedUrl) — пропускаем
  function uploadAllFiles(){
    var total = media.length;
    var chain = Promise.resolve();
    media.forEach(function(m, i){
      chain = chain.then(function(){
        if (m.uploadedUrl){ setFileProgress(i, 100, 'Готово'); return; }
        setProg((i/total)*100);
        return uploadOneMediaItem(i, function(pct){
          setProg(((i + pct/100)/total)*100);
        });
      });
    });
    return chain.then(function(){ setProg(100); });
  }

  // ф3: аплоад ОДНОГО файла по клику на кнопку карточки (вне общей пачки/общего прогресс-бара)
  function uploadSingleFile(i){
    var m = media[i]; if (!m) return;
    uploadOneMediaItem(i)
      .then(function(){
        updatePublishBtnLabel();
        renderPubPreview();
      })
      .catch(function(e){
        renderPubPreview();
        if (!(e && e.aborted)) showToast((e&&e.message)||'Ошибка загрузки файла');
      });
  }

  // ф3: "пауза" — честная интерпретация при XHR-транспорте без byte-range resume:
  // прерываем все ещё летящие загрузки (общую пачку и/или одиночные), сбрасываем
  // publishing и возвращаем кнопку в состояние "Загрузить файлы". Повторное нажатие
  // перезапустит аплоад ТОЛЬКО недогруженных файлов — уже готовые (uploadedUrl) не трогаются.
  function pauseUpload(){
    var aborted = false;
    media.forEach(function(m){
      if (m.uploading && m._abort){ try{ m._abort(); }catch(e){} aborted = true; }
      m.uploading = false; m._abort = null;
    });
    publishing = false;
    var btn = el('mskcPublish2');
    if (btn) btn.disabled = false;
    setProg(null);
    updatePublishBtnLabel();
    renderPubPreview();
    if (aborted) showToast('Загрузка на паузе');
  }

  // клик по кнопке публикации: диспетчер шага 1 (аплоад) / шага 2 (собственно публикация)
  function onPublishBtn(){
    if (publishing) return;                // защита от повторных нажатий
    var tags = validateForPublish();
    if (!tags) return;
    if (allUploaded()) doPublish(tags);
    else doUpload();
  }

  function doUpload(){
    publishing = true;
    el('mskcPublish2').disabled = true;
    el('mskcPublish2').textContent = 'Загрузка...';
    // сразу помечаем все ожидающие файлы "в процессе" и перерисовываем превью —
    // иначе кнопки поштучного аплоада (ф3) остались бы висеть поверх файлов,
    // которые вот-вот подхватит общая пачка (uploadAllFiles ставит uploading=true
    // лениво, по одному, по мере продвижения по цепочке)
    media.forEach(function(m){ if (!m.uploadedUrl) m.uploading = true; });
    renderPubPreview();
    uploadAllFiles()
      .then(function(){
        publishing = false;
        el('mskcPublish2').disabled = false;
        setProg(null);
        // не публикуем автоматически — оставляем пользователя на экране публикации,
        // чтобы он мог поправить подпись/хэштеги/18+ перед реальной отправкой
        updatePublishBtnLabel();
        renderPubPreview();
      })
      .catch(function(e){
        publishing = false;
        setProg(null);
        el('mskcPublish2').disabled = false;
        // сброс "в процессе" на всех незавершённых — иначе их карточки останутся без
        // кнопки поштучного аплоада после сорвавшейся/прерванной пачки
        media.forEach(function(m){ if (!m.uploadedUrl) m.uploading = false; });
        updatePublishBtnLabel();
        renderPubPreview();
        // при паузе (pauseUpload) сюда прилетает reject с aborted=true — pauseUpload
        // уже сама привела UI в порядок, лишний тост про "ошибку" тут не нужен
        if (!(e && e.aborted)) showToast((e&&e.message)||'Ошибка загрузки');
      });
  }

  function doPublish(tags){
    // теги/подпись читаем СЕЙЧАС — пользователь мог поправить их между аплоадом и публикацией
    tags = tags || collectTags();
    if (tags.length < 3){ showToast('Минимум 3 хэштега'); return; }
    var caption = (el('mskcCaption').value||'').trim();
    var full = (caption + ' ' + tags.map(function(t){return '#'+t;}).join(' ')).trim();
    var uploaded = media.map(function(m){ return { url:m.uploadedUrl, type:m.type }; });

    publishing = true;
    el('mskcPublish2').disabled = true;
    el('mskcPublish2').textContent = 'Публикация...';

    api('/miniska/new_v2','POST',{ caption: full, media: uploaded, is_nsfw: nsfw })
      .then(function(){
        showToast('Миниска опубликована');
        media.forEach(function(m){ if(m.localUrl) try{ URL.revokeObjectURL(m.localUrl); }catch(e){} });
        media=[]; idx=0; nsfw=false; tagFields=['','','']; el('mskcCaption').value='';
        el('mskcNsfw').classList.remove('on'); renderTagFields();
        setProg(null); close();
        // switchScreen('screenMinisky') взводит window._mskcPreserve (фича "не сбрасывать
        // ленту при возврате" из v11b-ф4), из-за чего следующий loadMinisky(true) тихо
        // пропускал реальную перезагрузку — свежая миниска не появлялась в ленте.
        // Здесь обновление намеренное, поэтому явно снимаем флаг перед вызовом.
        if (typeof switchScreen==='function') switchScreen('screenMinisky');
        window._mskcPreserve = false;
        if (typeof loadMinisky==='function'){ try{ loadMinisky(true); }catch(e){} }
      })
      .catch(function(e){ setProg(null); showToast((e&&e.message)||'Ошибка публикации'); })
      .finally(function(){
        publishing=false; el('mskcPublish2').disabled=false;
        updatePublishBtnLabel();
      });
  }

  function open(){
    build();
    el('mskCompose').classList.add('show');
    var startTab = (localStorage.getItem('gs_startTab')==='miniski') ? 'miniska' : 'miniska';
    // дефолт по выбору ленты: miniski->miniska, иначе пост? Пользователь хотел дефолт = выбор ленты.
    var pref = localStorage.getItem('gs_startTab');
    mobileCameraMode = isTouchCamera();
    if (mobileCameraMode) {
      setTab('miniska');
      openCamera();
    } else {
      setTab(pref==='posts' ? 'post' : 'miniska');
    }
  }
  function close(){ if (el('mskCompose')) { stopCamera(); el('mskCompose').classList.remove('show','camera-active'); } }

  // ── интеграция с навигацией: "+" открывает оверлей, остальное закрывает ──
  function hookNav(){
    if (typeof window.switchScreen !== 'function'){ return setTimeout(hookNav, 400); }
    var orig = window.switchScreen;
    window.switchScreen = function(id){
      if (id === 'screenCreate'){
        if (typeof isGuest==='function' && isGuest()){ return orig(id); }
        orig('screenCreate'); open();
      } else {
        close(); orig(id);
      }
    };
  }
  if (document.readyState!=='loading') hookNav(); else document.addEventListener('DOMContentLoaded', hookNav);
})();


/* ============================================================================
   v11b-fix — мелочи аудита: глушим отладочные console.log/debug в проде
   (gostPill/wallet.credit светили в консоль пользователю)
   ============================================================================ */
(function(){
  try{
    var _log = console.log, _dbg = console.debug;
    console.log = function(){
      // глушим только наши отладочные метки, остальное пропускаем
      var a0 = arguments[0];
      if (typeof a0==='string' && (/^\[(gostPill|wallet\.credit)\]/.test(a0))) return;
      return _log.apply(console, arguments);
    };
  }catch(e){}
})();

/* ============================================================================
   v11c — КАРУСЕЛЬ-ПРОСМОТР миниск в ленте
   - горизонтальный свайп по центру = листание вложений (фото/видео)
   - вертикальный свайп не трогаем (между минисками, scroll-snap)
   - точки-индикаторы, автолистание (фото 5с+3с, видео конец+5с), сброс по тачу
   - на видео-слайде работает ползунок перемотки
   (аудио — следующим заходом)
   ============================================================================ */
(function(){
  var PHOTO_MS = 5000, PHOTO_NUDGE_MS = 3000, VIDEO_TAIL_MS = 5000, INTERACT_MS = 16000;
  var _mskActiveCard = null; // текущая активная (в зоне видимости) карточка — для клавиатуры на десктопе

  function isDesktop(){ return window.innerWidth >= 1000; }

  function init(){
    if (typeof _mskItems === 'undefined' || typeof setupMiniskyTaps !== 'function'){
      return setTimeout(init, 500);
    }

    window.renderMinisky = function(){
      var feed = document.getElementById('mskFeed'); if(!feed) return;
      feed.innerHTML = _mskItems.map(function(p){
        var media = (p.media || []); if (!media.length) return '';
        var your = p.reactions && p.reactions.your_emoji;
        var reactsTotal = (p.reactions && p.reactions.total) || 0;
        var reactCounts = (p.reactions && p.reactions.counts) || {};
        var topReacts = EMOJI_ORDER.filter(function(k){ return reactCounts[k]; }).sort(function(a,b){ return reactCounts[b]-reactCounts[a]; }).slice(0,3);
        var reactCluster = topReacts.length ? '<div class="msk-react-cluster" data-counts=\''+JSON.stringify(reactCounts)+'\'><div class="msk-rc-icons">'+topReacts.map(function(k){ return '<span class="msk-rc-ico">'+emojiSvg(k)+'</span>'; }).join('')+'</div></div>' : '';
        var slides = media.map(function(m, i){
          var inner = (m.type==='video')
            ? '<video src="'+esc(m.url)+'" preload="metadata" playsinline muted></video>'
            : '<img class="msk-photo" src="'+esc(m.url)+'">';
          return '<div class="mskc-fslide" data-i="'+i+'">'+inner+'</div>';
        }).join('');
        var dots = media.length>1 ? ('<div class="mskc-fdots">'+media.map(function(_,i){
          return '<span class="mskc-fdot'+(i===0?' active':'')+'"></span>';
        }).join('')+'</div>') : '';
        var vslider = '<div class="mskc-vslider"><div class="mskc-vslider-fill"></div><div class="mskc-vslider-thumb"></div><div class="mskc-vslider-cursor"></div></div>';
        return '<div class="msk-card" data-id="'+p.id+'" data-count="'+media.length+'" data-idx="0">'+
          '<div class="mskc-ftrack">'+slides+'</div>'+
          dots+
          vslider+
          '<div class="msk-play-overlay"><i class="fa-solid fa-play"></i></div>'+
          '<div class="msk-overlay"><div class="msk-info">'+
            '<div class="author" onclick="event.stopPropagation();openFullProfile('+jsAttr(p.username)+')">'+
              '<div class="av">'+avaInner(p)+'</div>'+
              '<div><div class="name">'+esc(p.display_name)+userBadgesHTML(p)+'</div><div class="un">@'+esc(p.username)+'</div></div>'+
            '</div>'+
            '<div class="caption">'+linkifyContent(p.content || '', '')+'</div>'+
          '</div></div>'+
          '<div class="msk-side">'+
            '<button class="msk-play-btn"><i class="fa-solid fa-pause"></i></button>'+
            '<button class="msk-react-btn'+(your?' liked':'')+'" data-id="'+p.id+'">'+(your?emojiSvg(your):'<i class="fa-regular fa-heart"></i>')+'</button>'+
            reactCluster+
            '<div class="lbl">'+reactsTotal+'</div>'+
            '<button onclick="event.stopPropagation();openComments('+p.id+')"><i class="fa-regular fa-comment"></i></button>'+
            '<div class="lbl">'+(p.comments_count||0)+'</div>'+
            '<button onclick="event.stopPropagation();openShareSheet('+p.id+')"><i class="fa-solid fa-share-nodes"></i></button>'+
            ((me && p.user_id===me.id) ? '<button onclick="event.stopPropagation();deletePost('+p.id+')"><i class="fa-solid fa-trash-can"></i></button>' : '')+
          '</div>'+
        '</div>';
      }).join('');
      // навешиваем карусель на каждую карточку
      feed.querySelectorAll('.msk-card').forEach(setupCarousel);
      // оставляем родную автопрокрутку/дозагрузку видео по видимости
      if (typeof setupMiniskyAutoplay==='function') setupMiniskyAutoplay();
      if (typeof setupMiniskyTaps==='function') setupMiniskyTaps();
    };

    // ───────── контроллер одной карточки-карусели ─────────
    function setupCarousel(card){
      if (card._mskcBound) return; card._mskcBound = 1;
      var track = card.querySelector('.mskc-ftrack');
      var count = parseInt(card.getAttribute('data-count')||'1', 10);
      var dots  = card.querySelectorAll('.mskc-fdot');
      var dotsWrap = card.querySelector('.mskc-fdots');
      var slider = card.querySelector('.mskc-vslider');
      var sliderFill = card.querySelector('.mskc-vslider-fill');
      var sliderThumb = card.querySelector('.mskc-vslider-thumb');
      var sliderCursor = card.querySelector('.mskc-vslider-cursor');
      var idx = 0, autoT = null, dir = null, x0=0, y0=0, dragging=false, w=0, interacted=false, engaged=false;

      function curSlide(){ return card.querySelectorAll('.mskc-fslide')[idx]; }
      function curVideo(){ var s=curSlide(); return s ? s.querySelector('video') : null; }

      function applyTransform(px){
        track.style.transform = 'translateX('+(-idx*100 + (px||0))+'%)';
      }
      function syncDots(){
        dots.forEach(function(d,i){ d.classList.toggle('active', i===idx); });
      }
      function showSliderIfVideo(){
        var v = curVideo();
        if (slider) slider.style.display = v ? 'block' : 'none';
        // точки уезжают под ползунок перемотки, чтобы не накладываться на него
        if (dotsWrap) dotsWrap.classList.toggle('below-slider', !!v);
      }

      function stopAllVideos(){
        card.querySelectorAll('video').forEach(function(v){ try{ v.pause(); }catch(e){} });
      }
      function playCurrentVideo(){
        var v = curVideo(); if(!v) return;
        v.loop = true; // зацикливаем (по ТЗ), но таймер перелистывания стартует после 1-го прохода
        v.muted = false;
        try{ v.currentTime = 0; }catch(e){}
        v.play().catch(function(){ v.muted=true; v.play().catch(function(){}); });
      }

      function clearAuto(){ if(autoT){ clearTimeout(autoT); autoT=null; } }
      // delay: базовая задержка; после любого взаимодействия — увеличена до 16с
      function scheduleAuto(){
        clearAuto();
        if (count<=1) return; // одиночное вложение — не листаем
        var v = curVideo();
        if (v){
          // видео крутится в цикле; засекаем КОНЕЦ первого прохода через timeupdate,
          // затем хвост (5с / 16с после тача) → листаем дальше (видео продолжает играть)
          var firstDone = false;
          var tail = interacted ? INTERACT_MS : VIDEO_TAIL_MS;
          var onTime = function(){
            if (firstDone) return;
            if (v.duration && v.currentTime >= v.duration - 0.25){
              firstDone = true;
              v.removeEventListener('timeupdate', onTime);
              autoT = setTimeout(function(){ go(idx+1); }, tail);
            }
          };
          v.addEventListener('timeupdate', onTime);
        } else {
          // фото: 5с → намёк → +3с → дальше; после взаимодействия — единая пауза 16с
          if (interacted){
            autoT = setTimeout(function(){ go(idx+1); }, INTERACT_MS);
          } else {
            autoT = setTimeout(function(){
              nudge();
              autoT = setTimeout(function(){ go(idx+1); }, PHOTO_NUDGE_MS);
            }, PHOTO_MS);
          }
        }
      }
      function nudge(){
        track.style.transition='transform .18s';
        track.style.transform='translateX('+(-idx*100 - 4)+'%)';
        setTimeout(function(){ track.style.transform='translateX('+(-idx*100)+'%)'; setTimeout(function(){ track.style.transition=''; },180); },180);
      }

      function go(n){
        stopAllVideos();
        idx = ((n % count) + count) % count; // зацикливаем
        card.setAttribute('data-idx', idx);
        track.style.transition='transform .28s cubic-bezier(.22,.61,.36,1)';
        applyTransform(0);
        setTimeout(function(){ track.style.transition=''; }, 300);
        syncDots(); showSliderIfVideo();
        playCurrentVideo();
        scheduleAuto();
        syncPlayBtn();
      }

      // первичная инициализация при появлении карточки в зоне видимости
      card._mskcActivate = function(){
        if (card._mskcIsActive) return; // уже активна — не перезапускаем видео повторно
        card._mskcIsActive = true;
        w = card.clientWidth || window.innerWidth;
        interacted = false; // свежая карточка — обычный темп автолистания
        showSliderIfVideo(); syncDots();
        playCurrentVideo(); scheduleAuto();
        syncPlayBtn();
        _mskActiveCard = card; // запоминаем активную карточку — нужна клавиатуре на десктопе
        // если панель комментов открыта (десктоп) и мы перелистнули на другую миниску —
        // подгружаем комменты именно этой, новой, а не оставляем старые
        var _cmA = document.getElementById('commentsModal');
        var _pidA = +card.getAttribute('data-id');
        if (_cmA && _cmA.classList.contains('open') && curCommentPostId !== _pidA && typeof openComments === 'function') {
          openComments(_pidA);
        }
      };
      card._mskcDeactivate = function(){
        if (!card._mskcIsActive) return;
        card._mskcIsActive = false;
        clearAuto(); stopAllVideos();
        if (_mskActiveCard === card) _mskActiveCard = null;
      };
      // клавиша "Пробел" (см. глобальный keydown-обработчик ниже), тап по видео и кнопка
      // над лайком — все переключают play/pause через эту единую функцию: тоггл + вспышка
      // статуса по центру + синхронизация кнопки-статуса.
      card._mskcToggleVideo = function(){
        var v = curVideo(); if (!v) return;
        interacted = true; scheduleAuto();
        if (v.paused){ v.play().catch(function(){}); flashPlayState(true); }
        else { v.pause(); flashPlayState(false); }
        syncPlayBtn();
      };
      var playBtn = card.querySelector('.msk-play-btn');
      var flashEl = card.querySelector('.msk-play-overlay');
      if (typeof _mskBindReactCluster === 'function') _mskBindReactCluster(card.querySelector('.msk-react-cluster'));
      function syncPlayBtn(){
        if (!playBtn) return;
        var v = curVideo();
        if (!v){ playBtn.style.display = 'none'; return; }
        playBtn.style.display = '';
        playBtn.innerHTML = v.paused ? '<i class="fa-solid fa-play"></i>' : '<i class="fa-solid fa-pause"></i>';
      }
      function flashPlayState(playing){
        if (!flashEl) return;
        flashEl.innerHTML = playing ? '<i class="fa-solid fa-play"></i>' : '<i class="fa-solid fa-pause"></i>';
        flashEl.classList.remove('flash');
        void flashEl.offsetWidth; // форсируем reflow, чтобы анимация перезапускалась при частых тапах подряд
        flashEl.classList.add('flash');
      }
      // одиночный клик откладываем на случай, если это первая половина двойного клика —
      // тогда dblclick ниже отменит отложенный тоггл, и сработает только лайк (без
      // "мигания" паузой туда-обратно перед лайком)
      var toggleClickT = null;
      function scheduleToggleVideo(){
        clearTimeout(toggleClickT);
        toggleClickT = setTimeout(function(){ card._mskcToggleVideo(); }, 260);
      }
      if (playBtn) playBtn.addEventListener('click', function(e){ e.stopPropagation(); scheduleToggleVideo(); });
      // держим кнопку-статус в синхроне, даже если видео поставили на паузу/играют не через тоггл выше
      card.addEventListener('play', function(e){ if (e.target === curVideo()) syncPlayBtn(); }, true);
      card.addEventListener('pause', function(e){ if (e.target === curVideo()) syncPlayBtn(); }, true);

      // ───── тач: только из ЛЕВЫХ 80% = карусель; правые 20% (кнопки) = свайп вкладок ─────
      track.addEventListener('touchstart', function(e){
        if (count<=1) return;
        var t=e.touches[0];
        w = card.clientWidth || window.innerWidth;
        // правые 20% отдаём пейджеру вкладок — карусель не вмешивается
        if (t.clientX > w*0.80){ engaged=false; return; }
        engaged=true;
        x0=t.clientX; y0=t.clientY; dir=null; dragging=true;
        clearAuto();
        e.stopPropagation();   // не даём пейджеру вкладок начать жест из зоны карусели
      }, {passive:true});

      track.addEventListener('touchmove', function(e){
        if (!dragging || !engaged || count<=1) return;
        var t=e.touches[0]; var dx=t.clientX-x0, dy=t.clientY-y0;
        if (dir===null){
          if (Math.abs(dx)>8 || Math.abs(dy)>8) dir = Math.abs(dx)>Math.abs(dy) ? 'h' : 'v';
        }
        if (dir==='h'){
          e.preventDefault();      // блокируем верт-скролл во время горизонтального листания
          e.stopPropagation();     // и пейджер вкладок
          var pct = (dx / w) * 100;
          if ((idx===0 && dx>0) || (idx===count-1 && dx<0)) pct *= 0.35; // резинка на краях
          applyTransform(pct);
        }
      }, {passive:false});

      track.addEventListener('touchend', function(e){
        if (!dragging || !engaged || count<=1){ dragging=false; engaged=false; return; }
        dragging=false;
        interacted = true; // любое касание → следующая авто-пауза 16с
        if (dir!=='h'){ engaged=false; scheduleAuto(); return; }
        e.stopPropagation();
        var t=(e.changedTouches&&e.changedTouches[0]); var dx=t?t.clientX-x0:0;
        var thr = w*0.22;
        if (dx<=-thr) go(idx+1);
        else if (dx>=thr) go(idx-1);
        else { // вернуть на место
          track.style.transition='transform .2s'; applyTransform(0);
          setTimeout(function(){ track.style.transition=''; },200);
          scheduleAuto();
        }
        engaged=false;
      });

      // тап по контенту (не свайп) — тоже считается взаимодействием (пауза 16с);
      // если это видео — тап (мобилка и десктоп) переключает паузу/воспроизведение
      // + вспышка статуса по центру (та же логика, что у пробела/кнопки над лайком)
      track.addEventListener('click', function(e){
        if (e.target.closest('button,a,.author,.mskc-vslider')) return;
        if (curVideo()) { scheduleToggleVideo(); return; }
        interacted = true; scheduleAuto();
      });

      // ───── десктоп: двойной клик = лайк (зеркалим _onDoubleTap для миниск) ─────
      card.addEventListener('dblclick', function(e){
        clearTimeout(toggleClickT); // это оказался двойной клик — отменяем отложенный тоггл паузы, останется только лайк
        if (!isDesktop()) return;
        if (e.target.closest('button,a,.author,.mskc-vslider,.msk-side')) return;
        var pid = +card.dataset.id;
        var p = (typeof _mskItems!=='undefined' && _mskItems) ? _mskItems.find(function(x){ return x.id===pid; }) : null;
        if (!p){ return; }
        if (typeof isGuest==='function' && isGuest()){ if (typeof guestBlock==='function') guestBlock(); return; }
        var had = p.reactions && p.reactions.your_emoji === 'heart';
        if (!had && typeof mskReact==='function') mskReact(pid);
        var h = document.createElement('div');
        h.className = 'dt-heart';
        h.innerHTML = (typeof emojiSvg==='function') ? emojiSvg('heart') : '';
        card.appendChild(h);
        requestAnimationFrame(function(){ h.classList.add('go'); });
        setTimeout(function(){ h.remove(); }, 900);
      });

      // ───── десктоп: перетаскивание мышью = аналог тач-свайпа по карусели ─────
      (function(){
        var mDragging=false, mDir=null, mx0=0, my0=0;
        track.addEventListener('mousedown', function(e){
          if (!isDesktop() || count<=1) return;
          if (e.target.closest('button,a,.author,.mskc-vslider')) return;
          w = card.clientWidth || window.innerWidth;
          if (e.clientX > w*0.80) return; // правые 20% — зона кнопок, как и в тач-варианте
          if (e.target.closest('img,video')) e.preventDefault(); // не даём браузеру начать drag-ghost
          mDragging=true; mDir=null; mx0=e.clientX; my0=e.clientY;
          clearAuto();
        });
        track.addEventListener('mousemove', function(e){
          if (!mDragging || count<=1) return;
          var dx=e.clientX-mx0, dy=e.clientY-my0;
          if (mDir===null){
            if (Math.abs(dx)>8 || Math.abs(dy)>8) mDir = Math.abs(dx)>Math.abs(dy) ? 'h' : 'v';
          }
          if (mDir==='h'){
            e.preventDefault();
            var pct=(dx/w)*100;
            if ((idx===0 && dx>0) || (idx===count-1 && dx<0)) pct *= 0.35;
            applyTransform(pct);
          }
        });
        function mEnd(e){
          if (!mDragging){ return; }
          mDragging=false;
          interacted = true;
          if (mDir!=='h'){ scheduleAuto(); return; }
          var dx = e.clientX!=null ? e.clientX-mx0 : 0;
          var thr = w*0.22;
          if (dx<=-thr) go(idx+1);
          else if (dx>=thr) go(idx-1);
          else {
            track.style.transition='transform .2s'; applyTransform(0);
            setTimeout(function(){ track.style.transition=''; },200);
            scheduleAuto();
          }
        }
        track.addEventListener('mouseup', mEnd);
        track.addEventListener('mouseleave', function(e){ if (mDragging) mEnd(e); });
      })();

      // ───── ползунок видео (перемотка) ─────
      if (slider){
        function bindVideoSlider(){
          var v = curVideo(); if(!v) return;
          if (!v._sliderBound){
            v._sliderBound=1;
            v.addEventListener('timeupdate', function(){
              if (curVideo()!==v) return;
              if (v.duration){
                var p=(v.currentTime/v.duration*100);
                if(sliderFill) sliderFill.style.width=p+'%';
                if(sliderThumb) sliderThumb.style.left=p+'%';
              }
            });
          }
        }
        var seeking=false;
        function seekAt(clientX){
          var v=curVideo(); if(!v||!v.duration) return;
          var r=slider.getBoundingClientRect();
          var p=Math.max(0,Math.min(1,(clientX-r.left)/r.width));
          v.currentTime=p*v.duration;
          if(sliderFill) sliderFill.style.width=(p*100)+'%';
          if(sliderThumb) sliderThumb.style.left=(p*100)+'%';
        }
        slider.addEventListener('touchstart', function(e){ seeking=true; clearAuto(); seekAt(e.touches[0].clientX); e.stopPropagation(); }, {passive:true});
        slider.addEventListener('touchmove', function(e){ if(seeking){ seekAt(e.touches[0].clientX); e.preventDefault(); e.stopPropagation(); } }, {passive:false});
        slider.addEventListener('touchend', function(e){ seeking=false; scheduleAuto(); e.stopPropagation(); });
        // ───── десктоп: наведение — полоса "толстеет" + фиолетовый кружок бежит за курсором ─────
        // (та же математика доли, что и в seekAt() выше); клик/протяжка мышью тоже перематывают.
        var mSeeking=false;
        function cursorAt(clientX){
          if (!sliderCursor) return;
          var r=slider.getBoundingClientRect();
          var p=Math.max(0,Math.min(1,(clientX-r.left)/r.width));
          sliderCursor.style.left=(p*100)+'%';
          return p;
        }
        slider.addEventListener('mouseenter', function(e){
          if (!isDesktop()) return;
          slider.classList.add('hovering');
          cursorAt(e.clientX);
        });
        slider.addEventListener('mousemove', function(e){
          if (!isDesktop()) return;
          cursorAt(e.clientX);
          if (mSeeking) seekAt(e.clientX);
        });
        slider.addEventListener('mouseleave', function(){
          if (!isDesktop()) return;
          slider.classList.remove('hovering');
          if (mSeeking){ mSeeking=false; scheduleAuto(); }
        });
        slider.addEventListener('mousedown', function(e){
          if (!isDesktop()) return;
          mSeeking=true; clearAuto(); seekAt(e.clientX); e.stopPropagation();
        });
        window.addEventListener('mouseup', function(){
          if (mSeeking){ mSeeking=false; scheduleAuto(); }
        });
        // подвязываем timeupdate при каждом показе видео
        var _showSlider = showSliderIfVideo;
        showSliderIfVideo = function(){ _showSlider(); bindVideoSlider(); };
      }

      // ───── кнопка реакции (❤ в .msk-side): тап = лайк, зажатие = бар выбора эмодзи ─────
      // Раньше карточка миниски рендерилась старым шаблоном с классом .msk-react-btn,
      // на который был навешан общий делегированный обработчик долгого нажатия. Этот
      // v11c-рендер (setupCarousel) использует свою разметку — навешиваем тут же, локально.
      (function(){
        var reactBtn = card.querySelector('.msk-react-btn');
        if (!reactBtn) return;
        var rpT = null, rpFired = false;
        function rid(){ return +reactBtn.getAttribute('data-id'); }
        function rcur(){ var pp = _mskItems.find(function(x){ return x.id === rid(); }); return pp && pp.reactions && pp.reactions.your_emoji; }
        function startPress(){
          rpFired = false;
          rpT = setTimeout(function(){
            rpFired = true;
            var cur = rcur();
            if (cur) mskApplyReaction(rid(), cur);        // реакция стоит → зажатие снимает
            else _mskOpenReactBar(reactBtn, rid());        // нет реакции → бар выбора
            if (navigator.vibrate) navigator.vibrate(12);
          }, 420);
        }
        function cancelPress(){ clearTimeout(rpT); }
        reactBtn.addEventListener('touchstart', function(e){ e.stopPropagation(); startPress(); }, { passive: true });
        reactBtn.addEventListener('touchmove', cancelPress, { passive: true });
        reactBtn.addEventListener('touchend', function(e){
          clearTimeout(rpT);
          if (!rpFired){ e.stopPropagation(); var cur = rcur(); mskApplyReaction(rid(), cur || 'heart'); }
          rpFired = false;
        }, { passive: true });
        reactBtn.addEventListener('mousedown', function(e){ if ('ontouchstart' in window) return; e.stopPropagation(); startPress(); });
        reactBtn.addEventListener('mouseup', cancelPress);
        reactBtn.addEventListener('mouseleave', cancelPress);
        reactBtn.addEventListener('click', function(e){
          e.stopPropagation();
          if ('ontouchstart' in window) return;  // тач уже обработан в touchend
          if (rpFired){ rpFired = false; return; }
          var cur = rcur();
          mskApplyReaction(rid(), cur || 'heart');
        });
      })();
    }

    // ПОЛНОСТЬЮ заменяем родную автопрокрутку (она играла первое видео карточки →
    // конфликт/повтор). Своя: активити карусели + дозагрузка ленты по приближению к концу.
    window.setupMiniskyAutoplay = function(){
      var feed=document.getElementById('mskFeed'); if(!feed) return;
      if (window._mskcObs) window._mskcObs.disconnect();
      window._mskcObs = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
          var card=e.target;
          // гистерезис: включаем при >0.6, но выключаем только при <0.25 — чтобы
          // микро-качание скролла (палец чуть тронул экран) не гасило и не
          // перезапускало видео; реальное переключение слайда даёт гораздо
          // больший перепад ratio и всё равно пересечёт обе границы.
          if (e.intersectionRatio>0.6){
            if(card._mskcActivate) card._mskcActivate();
            // дозагрузка: если близко к концу — подгружаем ещё
            var cards=[].slice.call(feed.querySelectorAll('.msk-card'));
            var i=cards.indexOf(card);
            if (i>=cards.length-2 && typeof _mskHasMore!=='undefined' && _mskHasMore && !_mskLoading && typeof loadMinisky==='function') loadMinisky(false);
          } else if (e.intersectionRatio<0.25){
            if(card._mskcDeactivate) card._mskcDeactivate();
          }
        });
      }, {root:feed, threshold:[0,0.25,0.6,1]});
      feed.querySelectorAll('.msk-card').forEach(function(c){ window._mskcObs.observe(c); });
    };

    // ───── десктоп: клавиатура — Пробел (play/pause), ↑/↓ (пред./след. миниска) ─────
    if (!window._mskcKeyBound){
      window._mskcKeyBound = 1;
      document.addEventListener('keydown', function(e){
        if (!isDesktop()) return;
        if (!_mskActiveCard) return;
        // не мешаем вводу текста где-либо на странице
        var tag = (document.activeElement && document.activeElement.tagName || '').toLowerCase();
        if (tag==='input' || tag==='textarea' || (document.activeElement && document.activeElement.isContentEditable)) return;
        // не мешаем, если миниски сейчас не активный экран
        var screen = document.getElementById('screenMinisky');
        if (!screen || !screen.classList.contains('active')) return;

        if (e.code==='Space'){
          e.preventDefault();
          if (_mskActiveCard._mskcToggleVideo) _mskActiveCard._mskcToggleVideo();
        } else if (e.code==='ArrowDown' || e.code==='ArrowUp'){
          e.preventDefault();
          var feedEl = document.getElementById('mskFeed');
          if (feedEl) feedEl.scrollBy({ top: (e.code==='ArrowDown' ? 1 : -1) * window.innerHeight, behavior: 'smooth' });
        }
      });
    }

    // ───── десктоп: fallback — колесо мыши/трекпад листает миниски по одной карточке ─────
    // Резервный путь на случай, если нативный scroll-snap почему-то не реагирует на wheel
    // в браузере пользователя (после тщательного разбора конкретной клиентской причины
    // не найдено — см. отчёт; это подстраховка, а не фикс первопричины). Не мешает нативному
    // scroll-snap: просто даёт ГАРАНТИРОВАННО рабочий альтернативный путь ввода с кулдауном,
    // чтобы одно вращение колеса не пролистывало сразу несколько карточек.
    if (!window._mskcWheelBound){
      window._mskcWheelBound = 1;
      var wheelCooldown = false;
      document.addEventListener('wheel', function(e){
        if (!isDesktop()) return;
        var screen = document.getElementById('screenMinisky');
        if (!screen || !screen.classList.contains('active')) return;
        var feedEl = document.getElementById('mskFeed');
        if (!feedEl || !feedEl.contains(e.target)) return;
        // если событие пришло изнутри ползунка перемотки — не мешаем ему
        if (e.target.closest && e.target.closest('.mskc-vslider')) return;
        if (wheelCooldown) return;
        if (Math.abs(e.deltaY) < 2) return; // игнорируем совсем крошечные/шумовые дельты
        wheelCooldown = true;
        feedEl.scrollBy({ top: Math.sign(e.deltaY) * window.innerHeight, behavior: 'smooth' });
        setTimeout(function(){ wheelCooldown = false; }, 500);
      }, { passive: true });
    }
  }
  if (document.readyState!=='loading') init(); else document.addEventListener('DOMContentLoaded', init);
})();

/* ============================================================================
   v11b-ф4 — сохранение позиции прокрутки при переключении Миниски↔Посты
   - запоминаем scrollTop каждой ленты; при возврате восстанавливаем
   - миниски при возврате НЕ перезагружаем (иначе рандом-порядок сбросит место)
   ============================================================================ */
(function(){
  function init(){
    if (typeof switchScreen!=='function'){ return setTimeout(init, 500); }
    var saved = {}; // screenId -> scrollPos
    function getScroll(id){
      if (id==='screenMinisky'){ var f=document.getElementById('mskFeed'); return f?f.scrollTop:0; }
      return window.scrollY || document.documentElement.scrollTop || 0;
    }
    function setScroll(id, v){
      if (id==='screenMinisky'){ var f=document.getElementById('mskFeed'); if(f) f.scrollTop=v; }
      else window.scrollTo(0, v);
    }

    var _origSwitch = window.switchScreen;
    window.switchScreen = function(screenId){
      // сохраняем позицию покидаемого экрана
      var cur = document.querySelector('.screen.active');
      if (cur && cur.id) saved[cur.id] = getScroll(cur.id);
      // при возврате на миниски с уже загруженными — просим не перезагружать
      if (screenId==='screenMinisky' && typeof _mskItems!=='undefined' && _mskItems && _mskItems.length){
        window._mskcPreserve = true;
      }
      _origSwitch.apply(this, arguments);
      // восстановим позицию целевого экрана (после рендера)
      if (saved[screenId]!=null){
        setTimeout(function(){ setScroll(screenId, saved[screenId]); }, 40);
        setTimeout(function(){ setScroll(screenId, saved[screenId]); }, 160);
      }
    };

    // не перезагружать миниски при возврате (сохранить место и порядок)
    if (typeof window.loadMinisky==='function'){
      var _origLoad = window.loadMinisky;
      window.loadMinisky = function(initial){
        if (initial===undefined) initial = true; // база зовёт loadMinisky() без аргумента
        if (initial && window._mskcPreserve && typeof _mskItems!=='undefined' && _mskItems && _mskItems.length){
          window._mskcPreserve = false;
          return; // пропускаем сброс — лента и место остаются
        }
        window._mskcPreserve = false;
        return _origLoad.call(this, initial);
      };
    }
  }
  if (document.readyState!=='loading') init(); else document.addEventListener('DOMContentLoaded', init);
})();

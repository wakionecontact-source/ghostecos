  return tpl.replace(/id="([a-zA-Z][\w-]*)"/g, (m, id) => `id="${id}${suf}"`)
            .replace(/url\(#([a-zA-Z][\w-]*)\)/g, (m, id) => `url(#${id}${suf})`);
}

